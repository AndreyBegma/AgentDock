# Copied to docker/.env by `bun run db:setup`; docker compose reads it automatically.
# Leave the passwords empty: db:setup generates random ones and writes them into
# the URLs of apps/api/.env that have no password yet.
POSTGRES_PASSWORD=
# Redis (BullMQ, cron schedules). Must match the password in REDIS_URL / TEST_REDIS_URL of apps/api/.env.
REDIS_PASSWORD=
