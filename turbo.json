{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "TRUST_PROXY",
        "APP_ENV",
        "BUN_BIN"
      ]
    },
    "start:dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL",
        "TRUST_PROXY",
        "APP_ENV",
        "PORT",
        "WEB_URL",
        "API_URL",
        "AUDIT_VERIFY_CRON",
        "APP_ENCRYPTION_KEY",
        "APP_URL",
        "TELEGRAM_POLL_TIMEOUT_S",
        "TELEGRAM_API_BASE"
      ]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
