{
  "name": "@nautelle/api",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "lint": "biome lint src",
    "test": "tsc --noEmit -p tsconfig.json && jest --maxWorkers=2",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --maxWorkers=2 --selectProjects e2e",
    "test:watch": "jest --watch --selectProjects unit",
    "test:cov": "jest --runInBand --coverage",
    "admin:create": "ts-node src/cli/admin-create.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@nautelle/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-ws": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.7",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "bullmq": "6.3.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "cron": "4.4.0",
    "cron-parser": "5.10.1",
    "cronstrue": "3.27.0",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "prisma": "7.7.0",
    "proxy-addr": "2.0.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/proxy-addr": "2.0.3",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "jest": "30.5.2",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "6.0.2"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testTimeout": 30000,
    "projects": [
      {
        "displayName": "unit",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "testPathIgnorePatterns": [
          "\\.e2e\\.spec\\.ts$"
        ],
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": "<rootDir>/../tsconfig.spec.json"
            }
          ]
        },
        "testEnvironment": "node"
      },
      {
        "displayName": "e2e",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.e2e\\.spec\\.ts$",
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": "<rootDir>/../tsconfig.spec.json"
            }
          ]
        },
        "globalSetup": "<rootDir>/test/global-setup.ts",
        "setupFiles": [
          "<rootDir>/test/e2e-env.ts"
        ],
        "testEnvironment": "node"
      }
    ]
  }
}
