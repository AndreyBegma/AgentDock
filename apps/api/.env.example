PORT=8180
# `production` marks the session and CSRF cookies Secure.
APP_ENV=development
API_URL=http://localhost:8180
WEB_URL=http://localhost:3517
# Express `trust proxy`: whose X-Forwarded-For to believe for the client IP
# (per-IP login throttle). `loopback` trusts a proxy on the same host — the web
# app's /api rewrite. Behind another reverse proxy, set its address or hop count.
TRUST_PROXY=loopback

DATABASE_URL="postgresql://postgres:change-me@localhost:5421/agentdock?schema=public"
# Database the e2e tests (`bun run test`) wipe and migrate on every run. Its
# name must end in _test; it is created if it does not exist.
TEST_DATABASE_URL="postgresql://postgres:change-me@localhost:5421/agentdock_test?schema=public"
# The runner e2e test starts the real runner daemon (apps/runner) with Bun.
# Defaults to `bun` on PATH.
# BUN_BIN=

# Cron schedule of the audit chain verification (server time). Default: nightly at 03:00.
# AUDIT_VERIFY_CRON="0 3 * * *"

# Requests re-priced per transaction by a price recompute (spec 13 D7). Default: 1000.
# USAGE_RECOMPUTE_BATCH=1000

# Key that seals secrets stored by AgentDock — the Telegram bot token
# (spec 22 D8): 32 random bytes, base64 (`openssl rand -base64 32`). Without it
# the Telegram integration refuses to store a token. Keep it out of backups of
# the database: either alone is useless, both together are the secret.
# APP_ENCRYPTION_KEY=

# Public URL of the web app, used in Telegram message links (spec 22 D10).
# APP_URL=http://localhost:3517
# Telegram long-poll timeout, seconds (spec 22 D7). Default: 30.
# TELEGRAM_POLL_TIMEOUT_S=30
# Telegram Bot API base URL. Default: https://api.telegram.org — tests point it at a mock.
# TELEGRAM_API_BASE=https://api.telegram.org

# Activity feed and run history projector poll interval, in ms (spec 21 D2).
# 0 turns the poll loop off. Default: 2000. It never runs under APP_ENV=test.
# ACTIVITY_POLL_MS=2000
# How long a hole in `events.id` is waited on before it is treated as a
# rolled-back id, in ms (spec 21 notes). Default: 10000.
# ACTIVITY_GAP_GRACE_MS=10000
# Days an activity item is kept; a daily job deletes older ones (spec 21 D6). Default: 180.
# ACTIVITY_RETENTION_DAYS=180

# Cron schedules (spec 25): `false` keeps this instance's scheduler loop off
# (maintenance). Default: true. It never runs under APP_ENV=test.
# SCHEDULER_ENABLED=true

# Interactive terminal attach (spec 29 D7), in seconds. An attach with no input
# (read-write) or no traffic at all (read-only) for the idle timeout closes with
# `idle`; any attach closes with `max_duration` at the maximum. Defaults: 900, 14400.
# TERMINAL_IDLE_TIMEOUT_SEC=900
# TERMINAL_MAX_DURATION_SEC=14400

# Webhooks (spec 26). `false` keeps the outbound dispatcher and delivery worker
# off on this instance (inbound triggers still answer). Default: true. They
# never run under APP_ENV=test. Trigger and webhook secrets need APP_ENCRYPTION_KEY.
# WEBHOOKS_WORKER_ENABLED=true

# `bun run admin:create` without prompts — set both, run, then remove them.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
