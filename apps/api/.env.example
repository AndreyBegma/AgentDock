PORT=8180
# `development` and `test` send the session and CSRF cookies over plain http;
# any other value, or none, marks them Secure. Set `production` when deployed.
APP_ENV=development
API_URL=http://localhost:8180
WEB_URL=http://localhost:3517
# Express `trust proxy`: whose X-Forwarded-For to believe for the client IP
# (per-IP login throttle, and the audited IP of /terminal and /runner sockets). `loopback` trusts a proxy on the same host — the web
# app's /api rewrite. Behind another reverse proxy, set its address or hop count.
# `true` trusts every hop and a client can forge X-Forwarded-For: the API refuses
# to boot with it when APP_ENV=production. Count the proxies between the client
# and the API, then pick the value for your topology:
#   dev, or single host (browser -> Next /api rewrite -> API)   loopback
#   nginx in front of Next (browser -> nginx -> Next -> API)    2
#   staging (Cloudflare -> cloudflared -> Caddy -> API)         uniquelocal
# Never `true` in production.
TRUST_PROXY=loopback

# The database and Redis URLs ship without a password: `bun run db:setup` writes
# the passwords it generates into docker/.env into every URL that has none.
DATABASE_URL="postgresql://postgres:@localhost:5421/agentdock?schema=public"
# Database the e2e tests (`bun run test`) wipe and migrate on every run. Its
# name must end in _test; it is created if it does not exist. It is the template
# of one database per Jest worker on the same server (agentdock_1_test, …),
# recreated on every run. In a board card's session (NAUTELLE_CARD, set by the
# runner) the suite uses the card's own database instead —
# agentdock_card_<id>_test — so card worktrees never wipe each other's (#389) —
# with a bounded pool (connection_limit=5&pool_timeout=10, #487).
# docs/guides/e2e-test-database.md.
TEST_DATABASE_URL="postgresql://postgres:@localhost:5421/agentdock_test?schema=public"
# Redis for BullMQ (cron schedules, ADR-0015). Required unless SCHEDULER_ENABLED=false;
# the API refuses to boot without it. The password is REDIS_PASSWORD of docker/.env.
REDIS_URL="redis://:@localhost:6421/0"
# Redis the e2e tests use. Each run keeps to its own key prefix and removes it on teardown.
TEST_REDIS_URL="redis://:@localhost:6421/1"
# Key prefix of every queue. Default: agentdock. The e2e suite sets a per-run one.
# QUEUE_PREFIX=agentdock
# The runner e2e test starts the real runner daemon (apps/runner) with Bun.
# Defaults to `bun` on PATH.
# BUN_BIN=

# Cron schedule of the audit chain verification (server time). Default: nightly at 03:00.
# AUDIT_VERIFY_CRON="0 3 * * *"

# Requests re-priced per transaction by a price recompute (spec 13 D7). Default: 1000.
# USAGE_RECOMPUTE_BATCH=1000

# Key that seals secrets stored by Nautelle — the Telegram bot token
# (spec 22 D8): 32 random bytes, base64 (`openssl rand -base64 32`). Without it
# the Telegram integration refuses to store a token. Keep it out of backups of
# the database: either alone is useless, both together are the secret.
# APP_ENCRYPTION_KEY=

# Public URL of the web app, used in Telegram message links (spec 22 D10) and
# as the Telegram Mini App's address when it is https (#580).
# APP_URL=http://localhost:3517
# Telegram long-poll timeout, seconds (spec 22 D7). Default: 30.
# TELEGRAM_POLL_TIMEOUT_S=30
# Telegram Bot API base URL. Default: https://api.telegram.org — tests point it at a mock.
# TELEGRAM_API_BASE=https://api.telegram.org
# How old, in seconds, a Telegram Mini App's initData may be when it signs in
# (#580): 60 to 86400. Default: 3600. The Mini App needs an https APP_URL; with
# any other the bot sends plain links instead of Mini App buttons.
# TELEGRAM_INIT_DATA_MAX_AGE_S=3600

# Activity feed and run history projector poll interval, in ms (spec 21 D2).
# 0 turns the poll loop off. Default: 2000. It never runs under APP_ENV=test.
# ACTIVITY_POLL_MS=2000
# How long a hole in `events.id` is waited on before it is treated as a
# rolled-back id, in ms (spec 21 notes). Default: 10000.
# ACTIVITY_GAP_GRACE_MS=10000
# Days an activity item is kept; a daily job deletes older ones (spec 21 D6). Default: 180.
# ACTIVITY_RETENTION_DAYS=180

# Cron schedules (spec 25, 123): `false` runs no schedules worker on this
# instance and needs no REDIS_URL (maintenance). Default: true. It never runs
# under APP_ENV=test.
# SCHEDULER_ENABLED=true

# Interactive terminal attach (spec 29 D7), in seconds. An attach with no input
# (read-write) or no traffic at all (read-only) for the idle timeout closes with
# `idle`; any attach closes with `max_duration` at the maximum. Defaults: 900, 14400.
# TERMINAL_IDLE_TIMEOUT_SEC=900
# TERMINAL_MAX_DURATION_SEC=14400

# Default time zone (IANA) a new budget's day, week or month is cut in (spec 28 D1).
# Default: UTC; an unknown zone falls back to UTC.
# APP_TIMEZONE=Europe/Berlin

# Webhooks (spec 26). `false` keeps the outbound dispatcher and delivery worker
# off on this instance (inbound triggers still answer). Default: true. They
# never run under APP_ENV=test. Trigger and webhook secrets need APP_ENCRYPTION_KEY.
# WEBHOOKS_WORKER_ENABLED=true

# GitHub App (spec 27). Public HTTPS base GitHub can reach for
# `POST /hooks/github` (docs/architecture/github-app.md). Unset: the App's hook
# is created inactive and every project keeps 60 s polling. The App's secrets
# need APP_ENCRYPTION_KEY; the manifest redirect uses APP_URL (else WEB_URL).
# PUBLIC_URL=https://dock.example.com
# GitHub REST API base. Default: https://api.github.com — tests point it at a mock.
# GITHUB_API_BASE=https://api.github.com

# Board card attachments (#309, ADR-0031). Where the API stores the bytes
# (`<projectId>/<attachmentId>`, uploads in `tmp/`); back it up with the
# database. Default: ./data/attachments, relative to the API's working directory.
# ATTACHMENTS_DIR=./data/attachments
# Bytes one project may store, pending uploads included. Default: 1073741824 (1 GiB).
# ATTACHMENTS_PROJECT_QUOTA_BYTES=1073741824
# Bytes of uploads not yet claimed by a card (and not expired) one user may hold;
# above it an upload is refused with 413 pending_exceeded (#156).
# Default: 268435456 (256 MiB).
# ATTACHMENTS_USER_PENDING_BYTES=268435456

# DeepL API key (#324, ADR-0033). Set: the free text people save is translated
# to English by DeepL inside the save (the text leaves this host for DeepL);
# a free key ends in `:fx`. Empty: the runner's `haiku` translates it later
# (ADR-0027). Server-side only — never logged, returned or sent to a runner.
DEEPL_API_KEY=

# Voice input of the Telegram `/new` intake (#594). The base URL of a
# Whisper-compatible speech-to-text API — the bot posts voice messages to
# `<base>/audio/transcriptions` (OpenAI-style multipart) and uses the text.
# The audio leaves this host for that service and is never stored. Unset: the
# bot answers that voice input is off. The key is sent as a bearer token
# (optional for a local server); server-side only. Model default: whisper-1.
# SPEECH_TO_TEXT_URL=https://api.openai.com/v1
# SPEECH_TO_TEXT_API_KEY=
# SPEECH_TO_TEXT_MODEL=whisper-1

# Master key of the LLM gateway (ADR-0059, #598): seals the AI provider keys set
# under Admin › AI providers with AES-256-GCM. 32 random bytes, base64
# (`openssl rand -base64 32`). Missing or malformed: the gateway does not start
# — no AI feature runs and no provider key can be stored — and the rest of the
# API runs on. Separate from APP_ENCRYPTION_KEY; keep it out of database
# backups: either alone is useless, both together are the keys.
# LLM_SECRETS_KEY=

# `bun run admin:create` without prompts — set both, run, then remove them.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
