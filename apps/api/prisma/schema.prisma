generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  operator
  viewer
}

enum UserStatus {
  pending
  active
  rejected
  disabled
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  role         Role       @default(viewer)
  status       UserStatus @default(pending)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  approvedBy                  User?                         @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers               User[]                        @relation("UserApprovals")
  sessions                    UserSession[]
  settingsUpdated             Setting[]
  runnersCreated              Runner[]                      @relation("RunnerCreatedBy")
  runnersLocal                Runner[]                      @relation("RunnerLocalUser")
  sessionsOwned               AgentSession[]                @relation("SessionOwner")
  actionRequestsRequested     ActionRequest[]               @relation("ActionRequestRequestedBy")
  actionRequestsDecided       ActionRequest[]               @relation("ActionRequestDecidedBy")
  projectsCreated             Project[]
  memberships                 ProjectMember[]               @relation("ProjectMembership")
  membersAdded                ProjectMember[]               @relation("ProjectMemberAddedBy")
  priceVersions               PriceVersion[]
  priceRecomputes             PriceRecompute[]
  llmProvidersUpdated         LlmProviderSetting[]
  llmCalls                    LlmCall[]
  assistantConversations      AssistantConversation[]
  commandRuns                 CommandRun[]
  orchestratorSettingsUpdated ProjectOrchestratorSettings[]
  mergeApprovalsDecided       MergeApproval[]
  notifications               Notification[]
  notificationRules           NotificationRule[]
  notificationMutes           NotificationMute[]
  telegramLink                TelegramLink?
  telegramLinkCodes           TelegramLinkCode[]
  skillInstallPreviews        SkillInstallPreview[]
  schedulesCreated            Schedule[]                    @relation("ScheduleCreatedBy")
  schedulesUpdated            Schedule[]                    @relation("ScheduleUpdatedBy")
  scheduleFirings             ScheduleFiring[]              @relation("ScheduleFiringPrincipal")
  budgets                     Budget[]                      @relation("BudgetUser")
  budgetsCreated              Budget[]                      @relation("BudgetCreatedBy")
  budgetOverrides             BudgetOverride[]              @relation("BudgetOverrideBy")
  budgetOverridesRevoked      BudgetOverride[]              @relation("BudgetOverrideRevokedBy")
  inboundTriggersCreated      InboundTrigger[]
  webhooksCreated             Webhook[]
  githubAppsRegistered        GitHubApp[]
  plannerInstructions         PlannerInstructions[]
  plannerSettingsUpdated      PlannerSettings[]
  plans                       Plan[]
  planTurns                   PlanTurn[]
  uiProfilesAuthored          UiProfile[]
  designSettingsUpdated       DesignSettings[]
  taskDesignsApproved         TaskDesign[]
  designComments              DesignComment[]
  boardCardsCreated           BoardCard[]                   @relation("BoardCardCreatedBy")
  boardStacksCreated          BoardStack[]                  @relation("BoardStackCreatedBy")
  boardCardsMoved             BoardCard[]                   @relation("BoardCardMovedBy")
  boardCardsCompleted         BoardCard[]                   @relation("BoardCardCompletedBy")
  boardCardRounds             BoardCardRound[]
  boardSettingsUpdated        BoardSettings[]
  cardDismissals              CardDismissal[]
  textNormalizations          TextNormalization[]
  textSettingsUpdated         TextSettings[]
  attachmentsUploaded         Attachment[]
  tokenSaverSettingsUpdated   TokenSaverSettings[]
  stewardSettingsUpdated      StewardSettings[]
  settings                    UserSettings?
  planCandidatesDecided       PlanCandidate[]               @relation("PlanCandidateDecidedBy")

  @@map("users")
}

/// #337 D9: a person's own settings. No row: the defaults (shared
/// `USER_SETTINGS_DEFAULTS`).
model UserSettings {
  userId        String   @id
  /// The model New Card and New Plan preselect; null: `PLANNING_MODEL_DEFAULT`.
  planningModel String?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Failed password checks of one source against one account (C-109, D-05):
/// keyed by the email as typed, so an unknown address is throttled exactly
/// like a real one. A source waits only for its own failures; no row, no wait.
model LoginThrottle {
  email         String
  ip            String
  failures      Int
  lastFailureAt DateTime
  /// The source may not try again before this.
  blockedUntil  DateTime?

  @@id([email, ip])
  @@index([lastFailureAt])
  @@map("login_throttles")
}

/// A login session. Named `UserSession` because `Session` is reserved for agent
/// runtime sessions (docs/architecture/data-model.md).
model UserSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

enum Runtime {
  claude
  codex
}

/// A machine running the agentdock-runner daemon (docs/specs/6). Status is
/// derived from the live socket, never stored. Only hashes of the token live
/// here; `tokenPrefix` is its first 8 characters, used to find the row.
model Runner {
  id              String    @id @default(cuid())
  name            String
  hostname        String?
  version         String?
  protocolVersion Int?
  os              String?
  arch            String?
  capabilities    Json?
  tokenHash       String?
  tokenPrefix     String?   @unique
  /// Highest contiguous event seq persisted — `welcome.ackedSeq` / `ack.seq`.
  ackedSeq        BigInt    @default(0)
  pairedAt        DateTime?
  lastSeenAt      DateTime?
  revokedAt       DateTime?
  /// Nullable so deleting the admin who created it keeps the runner.
  createdById     String?
  /// The user a local request (hook or MCP) acts as (spec 201 D8); backfilled
  /// from `createdById`. Null: every local request is `forbidden`.
  localUserId     String?
  /// Away mode: permission prompts go to the web app and Telegram (spec 201 D17).
  awayMode        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy            User?                 @relation("RunnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  localUser            User?                 @relation("RunnerLocalUser", fields: [localUserId], references: [id], onDelete: SetNull)
  pairingCodes         RunnerPairingCode[]
  profiles             RuntimeProfile[]
  events               Event[]
  projects             Project[]
  sessions             AgentSession[]
  commandRuns          CommandRun[]
  notifications        Notification[]
  incidents            RunnerIncident[]
  installedSkills      InstalledSkill[]
  skillInstallPreviews SkillInstallPreview[]
  actionRequests       ActionRequest[]

  @@map("runners")
}

model RunnerPairingCode {
  id        String    @id @default(cuid())
  runnerId  String
  /// SHA-256 of the normalised code; the code itself is shown once.
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@index([runnerId])
  @@map("runner_pairing_codes")
}

/// Mirrors the profiles of the runner's latest `hello` (ADR-0006). Rows absent
/// from it are marked `missing`, never deleted: later runs reference them.
model RuntimeProfile {
  id            String   @id @default(cuid())
  runnerId      String
  /// The profile `id` from the runner config.
  key           String
  runtime       Runtime
  label         String
  binary        String?
  /// Environment the runner sets — paths only, never credentials.
  env           Json
  args          Json
  authenticated Boolean
  missing       Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  runner               Runner                        @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  defaultProjects      Project[]
  orchestratorSettings ProjectOrchestratorSettings[]

  @@unique([runnerId, key])
  @@map("runtime_profiles")
}

/// An event envelope received from a runner (event-schema.md). Stored once per
/// `(runnerId, seq)`; partitioning by month is deferred (ADR-0007).
model Event {
  id            BigInt   @id @default(autoincrement())
  runnerId      String
  seq           BigInt
  ts            DateTime
  type          String
  source        String
  projectRepo   String?
  projectRoot   String?
  slot          String?
  issue         Int?
  session       Json?
  data          Json
  receivedAt    DateTime @default(now())
  /// `data.pluginEventId` of a `code-sentinel` event — the plugin's `eid`
  /// (spec 16 D5). Null otherwise, and on an `events.duplicate`.
  pluginEventId String?
  /// Idempotency key of a server-originated row (`source` `api`, ADR-0014):
  /// one row per `(source, dedupeKey)`. Null on runner rows.
  dedupeKey     String?

  runner            Runner            @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  webhookDeliveries WebhookDelivery[]

  /// Runner rows have positive seqs; server-originated rows (ADR-0014) take
  /// `-nextval('server_event_seq')`, so the two never meet.
  @@unique([runnerId, seq])
  /// One plugin event per runner and project root. NULLs are distinct in
  /// PostgreSQL, so this binds plugin events only — a partial index without a
  /// `WHERE`.
  @@unique([runnerId, projectRoot, pluginEventId])
  /// One server-originated event per key; NULLs are distinct, as above.
  @@unique([source, dedupeKey])
  @@index([type, ts])
  /// "A plugin event in the last 24 h" for `fleetChannel` (spec 16 D8).
  @@index([projectRoot, source, receivedAt])
  @@map("events")
}

enum AuditActorType {
  user
  runner
  system
  anonymous
}

enum AuditResult {
  ok
  denied
  error
  requested
}

/// Append-only, hash-chained audit log (docs/specs/8). A trigger rejects UPDATE,
/// DELETE and TRUNCATE. Actor and project ids are plain columns, not foreign
/// keys: records outlive users and projects, and a SET NULL would be an UPDATE.
model AuditRecord {
  seq               BigInt         @id @default(autoincrement())
  ts                DateTime       @default(now())
  actorType         AuditActorType
  actorUserId       String?
  actorRunnerId     String?
  /// A `system` actor's principal (#102); hashed only when set.
  actorOnBehalfOfId String?
  action            String
  targetType        String
  targetId          String?
  projectId         String?
  before            Json?
  after             Json?
  result            AuditResult
  meta              Json?
  /// `hash` of the previous record by `seq`; 64 zeros for the first.
  prevHash          String
  /// sha256(prevHash ‖ canonical(record)), hex.
  hash              String         @unique

  @@index([ts])
  @@index([action, ts])
  @@index([actorUserId, ts])
  @@index([actorOnBehalfOfId, ts])
  @@index([projectId, ts])
  @@index([targetType, targetId])
  @@map("audit_records")
}

/// Repeats of one audit record within a minute (C-109): the first is written
/// at once, the rest are counted here and written as one record when the
/// minute is over. Not part of the chain; rows are deleted once written.
model AuditFold {
  action     String
  targetType String
  /// `''` for no target id.
  targetId   String
  /// `''` for no address.
  ip         String
  minute     DateTime
  actor      Json
  result     AuditResult
  userAgent  String?
  /// Repeats after the first.
  count      Int         @default(0)
  /// `meta.reason` of each repeat → how many.
  reasons    Json        @default("{}")

  @@id([action, targetType, targetId, ip, minute])
  @@index([minute])
  @@map("audit_folds")
}

/// Where a project's base branch came from (docs/specs/10 D4).
enum BaseSource {
  config
  origin_head
  gh
  default
}

enum DocsSourceKind {
  in_repo
  sibling_repo
  remote_repo
  none
}

/// The docs-detection rule that found a docs source (docs/specs/10 D6).
enum DocsRule {
  spec_dir
  sibling
  same_owner_remote
  text_link
  back_link
  in_repo
}

/// A git repository on a runner (docs/specs/10). `rootPath` is its main
/// checkout; the same `owner/name` on two runners is two projects (D14).
model Project {
  id                          String     @id @default(cuid())
  runnerId                    String
  rootPath                    String
  /// `owner/name` on GitHub — the only forge a project connects on (ADR-0004).
  repo                        String
  displayName                 String
  baseBranch                  String
  baseSource                  BaseSource
  baseOverride                String?
  readyLabelOverride          String?
  /// Must belong to `runnerId`; checked by the API.
  defaultProfileId            String?
  /// Stored for M2.5; nothing reads it yet.
  mergeApproval               Boolean    @default(false)
  /// Store redacted session content from hooks (ADR-0021). Off by default.
  shipSessionContent          Boolean    @default(false)
  /// 1–365, validated by the DTO.
  sessionContentRetentionDays Int        @default(30)
  /// The `orchestrator` block of `.code-analyzer-config.json` and/or its parse error.
  codeSentinelConfig          Json?
  hasClaudeMd                 Boolean
  hasAgentsMd                 Boolean
  lastInspectedAt             DateTime
  /// Nullable so deleting the admin who connected it keeps the project.
  createdById                 String?
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  runner               Runner                       @relation(fields: [runnerId], references: [id], onDelete: Restrict)
  defaultProfile       RuntimeProfile?              @relation(fields: [defaultProfileId], references: [id], onDelete: SetNull)
  createdBy            User?                        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members              ProjectMember[]
  docsSource           DocsSource?
  rounds               Round[]
  slots                Slot[]
  orchestrator         FleetOrchestrator?
  sessions             AgentSession[]
  workflows            SessionWorkflow[]
  issues               IssueCache[]
  queueStates          QueueStateRow[]
  issueFeed            IssueFeed?
  commandRuns          CommandRun[]
  orchestratorSettings ProjectOrchestratorSettings?
  activityItems        ActivityItem[]
  runs                 Run[]
  mergeApprovals       MergeApproval[]
  notifications        Notification[]
  notificationMutes    NotificationMute[]
  installedSkills      InstalledSkill[]
  skillInstallPreviews SkillInstallPreview[]
  schedules            Schedule[]
  budgets              Budget[]
  inboundTriggers      InboundTrigger[]
  githubAppHealth      GitHubProjectHealth?
  plannerInstructions  PlannerInstructions[]
  plannerSettings      PlannerSettings?
  plans                Plan[]
  sessionContents      SessionContent[]
  actionRequests       ActionRequest[]
  uiProfiles           UiProfile[]
  designSettings       DesignSettings?
  boardCards           BoardCard[]
  boardStacks          BoardStack[]
  boardSettings        BoardSettings?
  cardCaptures         CardCapture[]
  cardDismissals       CardDismissal[]
  textNormalizations   TextNormalization[]
  textSettings         TextSettings?
  attachments          Attachment[]
  assistantConversations AssistantConversation[]
  tokenSaverSettings   TokenSaverSettings?
  tokenSaverStats      TokenSaverStat[]
  stewardSettings      StewardSettings?
  stewardIncidents     StewardIncident[]
  stewardDigests       StewardDigest[]
  handoffNotes         HandoffNote[]
  rules                ProjectRule[]
  telegramLinks        TelegramLink[]
  telegramIntakes      TelegramIntake[]

  @@unique([runnerId, rootPath])
  @@map("projects")
}

/// An operator's or viewer's access to a project (D11). Admins need no row.
model ProjectMember {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  /// Lowers the member's global role on this project; never raises it.
  roleOverride Role?
  /// Nullable so deleting the admin who added the member keeps the row.
  addedById    String?
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMembership", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("ProjectMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// Where a project's documentation lives (ADR-0012). `manual`: set by an admin
/// override, kept across refreshes.
model DocsSource {
  id         String         @id @default(cuid())
  projectId  String         @unique
  kind       DocsSourceKind
  localPath  String?
  repo       String?
  isGitRepo  Boolean
  detectedBy DocsRule?
  evidence   Json
  classified Json
  candidates Json
  manual     Boolean        @default(false)
  /// #379: where specs go, relative to the docs root. Set in Settings ›
  /// Docs source; detection and a refresh leave it alone.
  specDir    String?
  updatedAt  DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("docs_sources")
}

// ─── Fleet observation (docs/specs/11) ──────────────────────────────────────
// Projections of fleet events. Every row is a pure function of the events: a
// replayed event (`seq <= lastSeq`) changes nothing, and timestamps come from
// event `ts`, never from the clock, so a replay leaves the rows identical (D8).

/// `scraped`: parsed from a board file; `events`: from `events.jsonl` (M2.1).
enum RoundSource {
  scraped
  events
}

enum SlotStatus {
  dispatched
  running
  idle
  prompt
  quota
  stale
  ended
}

enum PaneState {
  busy
  prompt
  idle
  quota
}

enum PrState {
  open
  merged
  closed
}

enum PrChecks {
  pending
  green
  red
}

enum CheckpointKind {
  picked_up
  plan_ready
  implementation_done
  pr_open
  blocked
  misclassified
  other
}

/// `unknown` is a null status (or no row).
enum OrchestratorStatus {
  running
  idle
  absent
}

/// One orchestrator round: the header and four tables of `round-<HHMM>.md`.
model Round {
  id        String      @id @default(cuid())
  projectId String
  date      DateTime    @db.Date
  /// `HHMM`.
  label     String
  base      String
  occupied  Int
  max       Int
  free      Int
  /// `{ dispatching, heldForLead, notDispatching, inFlight }`, rows keyed by column header.
  decisions Json
  source    RoundSource
  boardPath String
  /// Which source last wrote each field group: `{ header?, decisions? }`
  /// (spec 16 D7). `scraped` never overwrites `code-sentinel`.
  sources   Json        @default("{}")
  /// Highest event `seq` applied; older ones are replays.
  lastSeq   BigInt
  createdAt DateTime
  updatedAt DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, label])
  @@map("rounds")
}

/// One run of a slot, from its brief or tmux session to its end. A name is
/// reused by later runs, each a new row (`startedAt`). Ended slots are kept as
/// history.
model Slot {
  id             String          @id @default(cuid())
  projectId      String
  name           String
  issue          Int?
  branch         String?
  worktree       String
  runtime        Runtime         @default(claude)
  model          String?
  modelWhy       String?
  owns           Json
  never          Json
  lead           Boolean?
  /// `YYYY-MM-DD/HHMM` of the brief that dispatched this run.
  round          String?
  /// Derived from the inputs below (spec 11 D8); never set on its own.
  status         SlotStatus
  /// null until the tmux session is first seen.
  sessionAlive   Boolean?
  pane           PaneState?
  worktreeExists Boolean         @default(true)
  ahead          Int?
  behind         Int?
  dirty          Boolean?
  prNumber       Int?
  prUrl          String?
  prState        PrState?
  prChecks       PrChecks?
  prMergeable    Boolean?
  lastCheckpoint CheckpointKind?
  /// Which source last wrote each field group — `{ model?, checkpoint?, pr? }`
  /// — plus `dispatchedAt` (the plugin's dispatch `ts`) and `checkpoints`
  /// (plugin checkpoints applied) for matching (spec 16 D7, Q3).
  sources        Json            @default("{}")
  /// Highest event `seq` applied; older ones are replays.
  lastSeq        BigInt
  startedAt      DateTime
  endedAt        DateTime?
  updatedAt      DateTime

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkpoints SlotCheckpoint[]
  run         Run?

  @@unique([projectId, name, startedAt])
  @@index([projectId, status])
  @@map("slots")
}

/// A `##` heading of a slot's `.orchestrator-reply.md`. The file is
/// append-only and has no timestamps, so a heading is identified by its
/// position; `at` is when the runner first saw it.
model SlotCheckpoint {
  id       String         @id @default(cuid())
  slotId   String
  kind     CheckpointKind
  heading  String
  summary  String
  position Int
  at       DateTime

  slot   Slot                     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  notice BlockedCheckpointNotice?

  @@unique([slotId, position])
  @@map("slot_checkpoints")
}

/// The orchestrator's presence on a project (D6) and the last board or brief
/// the runner could not parse (D4).
model FleetOrchestrator {
  projectId  String              @id
  /// null (or no row): never observed — `unknown`.
  status     OrchestratorStatus?
  session    String?
  /// When `status` last changed.
  since      DateTime?
  /// `{ file, line, reason, at }` of the last `board.unparsed`, cleared by the next parsed round.
  boardError Json?
  lastSeq    BigInt
  updatedAt  DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("fleet_orchestrators")
}

enum QuerySource {
  main
  subagent
  auxiliary
}

/// `computed` from the price table, or `ingested` as reported by the runtime (#13).
enum CostSource {
  computed
  ingested
}

/// An agent session found in a runtime's transcripts (docs/specs/12). Built from
/// `session.observed`, `turn.*`, `llm.request` and `tool.call` events, and from
/// `hook.*` events (spec 201 D14). No prompt, response or tool-argument text is
/// stored here (D9); hook content lives in `session_contents`, only for projects
/// that opted in (ADR-0021). A row created by an event that arrived before its
/// `session.observed` has `cwd = ''` until that event comes.
model AgentSession {
  id              String            @id @default(cuid())
  runnerId        String
  runtime         Runtime
  profileKey      String?
  /// The runtime's own session id.
  externalId      String
  /// Null: no connected project contains `cwd` — visible to admins only (D10).
  projectId       String?
  slotName        String?
  cwd             String
  gitBranch       String?
  title           String?
  /// Distinct models used, in order of first use.
  models          Json              @default("[]")
  /// The session this subagent session belongs to.
  parentSessionId String?
  parsed          Boolean           @default(true)
  startedAt       DateTime
  lastEventAt     DateTime
  endedAt         DateTime?
  /// A subagent's type (Claude's `agentType`, e.g. `Explore`), from its
  /// requests' `agentName`; written by the workflows sink (#161).
  agentType       String?
  /// worker (slot) / run / manual (hooks seen) / unknown (spec 201 D14).
  origin          SessionOrigin     @default(unknown)
  /// The slot's issue, or the number in a `<kind>/<n>-…` branch.
  issue           Int?
  /// For a manual session: the runner's local user.
  ownerId         String?
  /// Live state from hooks; null for sessions no hook has reported.
  liveState       SessionLiveState?
  /// `agentdock-manual-*` tmux session from `agentdock-runner claude` (D23).
  tmuxSession     String?

  runner         Runner               @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  owner          User?                @relation("SessionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent         AgentSession?        @relation("SessionParent", fields: [parentSessionId], references: [id], onDelete: SetNull)
  children       AgentSession[]       @relation("SessionParent")
  turns          Turn[]
  llmRequests    LlmRequest[]
  toolCalls      ToolCall[]
  spawnedBy      ToolCall[]           @relation("ToolCallChild")
  compactions    SessionCompaction[]
  errors         SessionError[]
  workflow       SessionWorkflow?
  workflowMark   SessionWorkflowMark?
  contents       SessionContent[]
  actionRequests ActionRequest[]
  assistantAttachments AssistantAttachment[]
  cardCaptures   CardCapture[]
  capturedCards  BoardCard[]          @relation("BoardCardSourceSession")
  trackedCard    BoardCard?           @relation("BoardCardTrackedSession")

  @@unique([runnerId, runtime, externalId])
  @@index([projectId, startedAt])
  @@index([parentSessionId])
  @@index([projectId, origin, lastEventAt])
  @@map("sessions")
}

/// What one user prompt caused, keyed by the runtime's `promptId`.
model Turn {
  id        String    @id @default(cuid())
  sessionId String
  promptId  String
  startedAt DateTime
  endedAt   DateTime?

  session     AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  llmRequests LlmRequest[]
  toolCalls   ToolCall[]

  @@unique([sessionId, promptId])
  @@map("turns")
}

/// One LLM API request, deduped on `requestId`; the last usage seen wins (D4).
/// The cost columns are declared here and filled by #13 (D8).
model LlmRequest {
  id                   String           @id @default(cuid())
  sessionId            String
  turnId               String?
  requestId            String
  ts                   DateTime
  model                String
  querySource          QuerySource
  input                Int              @default(0)
  output               Int              @default(0)
  cacheRead            Int              @default(0)
  cacheWrite5m         Int              @default(0)
  cacheWrite1h         Int              @default(0)
  /// Counted inside `output`; stored separately, never added twice.
  reasoning            Int              @default(0)
  durationMs           Int?
  /// `durationMs` was derived from timestamps, not measured.
  durationApprox       Boolean          @default(false)
  stopReason           String?
  costUsd              Decimal?         @db.Decimal(14, 6)
  /// `price_versions.number` the cost was computed with.
  priceVersion         Int?
  costSource           CostSource?
  /// The runtime's own cost estimate (Claude Code OTel `cost_usd`); for
  /// reference only, never in totals (spec 13 D6).
  reportedCostUsd      Decimal?         @db.Decimal(14, 6)
  /// The producer whose token counts the row holds (spec 13 D15).
  source               LlmRequestSource @default(transcript)
  /// All cache writes are in `cacheWrite5m`: the runtime did not split them by TTL.
  cacheWriteTtlUnknown Boolean          @default(false)

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn    Turn?        @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@unique([sessionId, requestId])
  @@index([ts])
  @@index([model, ts])
  @@map("llm_requests")
}

/// A tool use, closed by its result. `childSessionId`: the subagent it spawned.
model ToolCall {
  id             String    @id @default(cuid())
  sessionId      String
  turnId         String?
  toolUseId      String
  name           String
  startedAt      DateTime
  endedAt        DateTime?
  ok             Boolean?
  childSessionId String?

  session      AgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn         Turn?         @relation(fields: [turnId], references: [id], onDelete: SetNull)
  childSession AgentSession? @relation("ToolCallChild", fields: [childSessionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, toolUseId])
  @@index([childSessionId])
  @@map("tool_calls")
}

// ─── Workflows analytics (#161) ─────────────────────────────────────────────

enum CompactionTrigger {
  auto
  manual
}

/// A `session.compacted` event: the runtime summarized the conversation.
model SessionCompaction {
  id           String            @id @default(cuid())
  sessionId    String
  /// The transcript line's id.
  compactionId String
  ts           DateTime
  trigger      CompactionTrigger
  preTokens    Int?

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, compactionId])
  @@map("session_compactions")
}

/// A `session.error` event: a request the runtime gave up on. `kind` is an
/// error code, never a message (spec 12 D9).
model SessionError {
  id        String   @id @default(cuid())
  sessionId String
  /// The transcript line's id.
  errorId   String
  ts        DateTime
  kind      String
  status    Int?

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, errorId])
  @@map("session_errors")
}

/// A root session whose `session_workflows` row must be rebuilt: raised by
/// the workflows sink each time an event reaches its tree, deleted by the
/// projector once it built the row from that `seq`. Event times cannot be the
/// cursor: a runner replaying its spool sends old ones.
model SessionWorkflowMark {
  sessionId String @id
  seq       Int    @default(1)

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_workflow_marks")
}

/// One root session's workflow facts, projected from its tree by
/// `WorkflowsProjector` (#161). Definitions: `packages/shared/src/workflows`.
model SessionWorkflow {
  sessionId        String   @id
  projectId        String?
  runtime          Runtime
  profileKey       String?
  startedAt        DateTime
  /// The latest `lastEventAt` in the tree.
  lastEventAt      DateTime
  depth            Int
  subagents        Int
  compactions      Int
  /// A type name, or `~none` / `~unknown` (shared `WORKFLOW_AGENT_TYPE`).
  primaryAgentType String
  /// No LLM request in the tree came after its last `session.error`.
  errored          Boolean
  /// The root's last turn never finished.
  lastTurnOpen     Boolean
  builtAt          DateTime

  session     AgentSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  project     Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  transitions SessionToolTransition[]

  @@index([startedAt])
  @@index([projectId, startedAt])
  @@map("session_workflows")
}

/// Tool-call transitions inside one root session's tree (#161): `to` was
/// called right after `from` in the same turn of the same session.
model SessionToolTransition {
  sessionId String
  from      String
  to        String
  count     Int
  /// Transitions whose `to` call failed.
  errors    Int

  workflow SessionWorkflow @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@id([sessionId, from, to])
  @@map("session_tool_transitions")
}

// ─── Claude Code integration (docs/specs/201) ───────────────────────────────

enum SessionOrigin {
  unknown
  worker
  run
  manual
}

enum SessionLiveState {
  idle
  working
  waiting
  ended
}

enum SessionContentKind {
  prompt
  response
  tool_input
  tool_output
}

enum ActionRequestKind {
  tool_use
  orchestrator_start
  orchestrator_stop
  pr_approve
  issue_queue
}

enum ActionRequestStatus {
  pending
  approved
  denied
  expired
  executed
  failed
}

/// Redacted session text from hooks (ADR-0021): written only while the
/// project's `shipSessionContent` is on, deleted after its retention.
model SessionContent {
  id        BigInt             @id @default(autoincrement())
  sessionId String
  projectId String
  kind      SessionContentKind
  toolUseId String?
  toolName  String?
  at        DateTime
  text      String
  truncated Boolean            @default(false)
  createdAt DateTime           @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
  @@index([projectId, createdAt])
  @@map("session_contents")
}

/// An action a local session asked for and a person decides (spec 201 D18).
/// `tool_use` only returns the decision; the other kinds are executed as the
/// approver.
model ActionRequest {
  id            String              @id @default(cuid())
  projectId     String
  runnerId      String
  sessionId     String?
  /// The runner's local user. Nullable so deleting the user keeps the row.
  requestedById String?
  kind          ActionRequestKind
  summary       String
  args          Json
  status        ActionRequestStatus @default(pending)
  /// Nullable so deleting the user keeps the decision.
  decidedById   String?
  decidedAt     DateTime?
  note          String?
  result        Json?
  expiresAt     DateTime
  createdAt     DateTime            @default(now())

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runner      Runner        @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  session     AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  requestedBy User?         @relation("ActionRequestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?         @relation("ActionRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@index([status, expiresAt])
  @@map("action_requests")
}

// ─── Tokens and API-equivalent cost (docs/specs/13) ─────────────────────────

/**
 * `langfuse_seed` is `langfuse-seed` in the database and the API (shared `PRICE_SOURCES`).
 */
enum PriceSource {
  langfuse_seed @map("langfuse-seed")
  admin
}

/**
 * Which producer sent an `llm.request` (spec 13 D15).
 */
enum LlmRequestSource {
  transcript
  otel
}

enum RecomputeStatus {
  queued
  running
  done
  failed
}

/**
 * An immutable snapshot of every model price (D2). Editing prices creates a
 * new version; the highest `number` is current. Rows are never updated.
 */
model PriceVersion {
  id          String      @id @default(cuid())
  number      Int         @unique
  source      PriceSource
  note        String?
  /// Nullable so deleting the admin who created it keeps the version.
  createdById String?
  createdAt   DateTime    @default(now())

  createdBy  User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  models     ModelPrice[]
  recomputes PriceRecompute[]

  @@map("price_versions")
}

/**
 * One model's price in a version (D3): a case-insensitive regex on the model
 * id, a priority (lower wins), and ordered tiers (shared `PriceTier[]`).
 */
model ModelPrice {
  id           String @id @default(cuid())
  versionId    String
  modelName    String
  matchPattern String
  priority     Int
  tiers        Json

  version PriceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, modelName])
  @@map("model_prices")
}

/**
 * Usage per UTC hour × project × runtime × model × slot × run × issue (D8).
 * `dimensionKey` joins the dimensions (absent ones empty) so the unique index
 * has no nullable column. A pure aggregate of `llm_requests`: every write
 * rebuilds whole hours from them (spec 13 notes, deviation from D8).
 */
model UsageRollup {
  id               String   @id @default(cuid())
  hour             DateTime @db.Timestamptz(3)
  dimensionKey     String
  projectId        String?
  runtime          Runtime
  model            String
  slot             String?
  runId            String?
  issue            Int?
  requests         Int
  input            BigInt
  output           BigInt
  cacheRead        BigInt
  cacheWrite5m     BigInt
  cacheWrite1h     BigInt
  reasoning        BigInt
  costUsd          Decimal  @db.Decimal(14, 6)
  unpricedRequests Int

  @@unique([hour, dimensionKey])
  @@index([projectId, hour])
  @@index([hour])
  @@map("usage_rollups")
}

/**
 * A background re-pricing of `llm_requests` with `from <= ts < to` (D7).
 */
model PriceRecompute {
  id          String          @id @default(cuid())
  versionId   String
  from        DateTime
  to          DateTime
  status      RecomputeStatus @default(queued)
  processed   Int             @default(0)
  total       Int             @default(0)
  error       String?
  /// Nullable so deleting the admin who started it keeps the record.
  createdById String?
  createdAt   DateTime        @default(now())
  finishedAt  DateTime?

  version   PriceVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("price_recomputes")
}

// ─── Task queue (docs/specs/19-task-queue.md) ───────────────────────────────

enum IssueKind {
  issue
  pull_request
}

enum IssueState {
  open
  closed
}

enum IssueClosedBy {
  pr
  manual
}

enum QueueState {
  in_flight
  ready
  blocked_work
  blocked_person
  no_spec
}

enum QueueStateSource {
  computed
  orchestrator
}

/// The project's GitHub issues and open pull requests as the runner's `issues`
/// collector last saw them (D2). A row absent from a snapshot's `open` list is closed.
model IssueCache {
  id          String         @id @default(cuid())
  projectId   String
  number      Int
  /// Pull requests are kept only for their `Closes #n` (D3 `IN FLIGHT`).
  kind        IssueKind      @default(issue)
  title       String
  state       IssueState
  /// string[]
  labels      Json
  /// string[] of GitHub logins.
  assignees   Json
  /// Trimmed by the runner to 64 KB (16 KB for a pull request).
  body        String
  url         String
  ghUpdatedAt DateTime
  /// From `issue.closed`; null while open or not yet reported.
  closedBy    IssueClosedBy?
  closingPr   Int?
  closedAt    DateTime?
  /// When the row's content last changed — D4 compares a round against it.
  snapshotAt  DateTime
  /// Highest event `seq` applied; older ones are replays.
  lastSeq     BigInt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId, state])
  @@map("issues_cache")
}

/// The queue state of each open ready issue, recomputed on every change of its inputs.
/// `state`/`why`/`clears` are AgentDock's own (D3); `source` says whether the
/// orchestrator's fresher verdict (D4) is the one shown.
model QueueStateRow {
  id                 String           @id @default(cuid())
  projectId          String
  issueNumber        Int
  state              QueueState
  why                String
  clears             String?
  source             QueueStateSource
  orchestratorState  QueueState?
  orchestratorWhy    String?
  orchestratorClears String?
  /// Issue numbers named by `Depends on` that still block it.
  blockers           Json
  /// `{ slot, lead, model }[]` of the body's `## Parallel plan`; null without one.
  waveSlots          Json?
  computedAt         DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, issueNumber])
  @@map("queue_states")
}

/// The `issues` collector's last poll of a project: when it fetched, and why it failed.
model IssueFeed {
  projectId         String    @id
  /// `fetchedAt` of the last snapshot part applied; null before the first.
  fetchedAt         DateTime?
  snapshotId        String?
  /// The last `issues.unavailable`, cleared by the next snapshot.
  unavailableReason String?
  unavailableAt     DateTime?
  /// Highest `issues.snapshot` / `issues.unavailable` seq applied.
  lastSeq           BigInt
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("issue_feeds")
}

// ─── Orchestrator and slot control (docs/specs/17) ───────────────────────────

enum CommandRunStatus {
  requested
  ok
  error
  unknown
}

/// The D3 permission modes; `manual` is the runtime's default, prompting mode.
enum OrchestratorPermissionMode {
  auto
  acceptEdits
  bypassPermissions
  manual
}

/// A control command sent from the UI and how it ended (D10). `unknown`: the
/// runner did not answer within the command's timeout.
model CommandRun {
  id          String           @id @default(cuid())
  projectId   String
  runnerId    String
  /// Nullable so deleting the user keeps the log.
  userId      String?
  command     String
  /// The command's args as sent — `slot.message` text included (D10).
  args        Json
  slot        String?
  status      CommandRunStatus @default(requested)
  /// `{ code, message? }` when `status` is `error`.
  error       Json?
  result      Json?
  requestedAt DateTime         @default(now())
  finishedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runner  Runner  @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, requestedAt])
  @@map("command_runs")
}

/// The project's orchestrator launch defaults (D3). No row: the D3 defaults
/// and the project's default profile.
model ProjectOrchestratorSettings {
  projectId      String                     @id
  /// Must belong to the project's runner; checked by the API.
  profileId      String?
  model          String                     @default("opus")
  permissionMode OrchestratorPermissionMode @default(auto)
  updatedById    String?
  updatedAt      DateTime                   @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile   RuntimeProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  updatedBy User?           @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("project_orchestrator_settings")
}

// ─── Notifications and Telegram (docs/specs/22) ─────────────────────────────

/// A notification for one user (D11). `kind` is shared `NotificationKind`.
/// Repeats of the same `(user, kind, project, slot)` within 15 minutes of
/// `firstAt` fold into it — `count`, `lastAt` (D6). `eventId`: the event that
/// created it; the unique key makes matching an event twice a no-op (D4).
/// `lastEventId`: the newest event in it — the matcher goes in id order, so
/// an event at or below it is a replay and is not folded again.
model Notification {
  id          BigInt    @id @default(autoincrement())
  userId      String
  kind        String
  projectId   String?
  /// Set-null so deleting a runner keeps its project's notifications.
  runnerId    String?
  slot        String?
  issue       Int?
  title       String
  body        String
  /// Path in the web app.
  link        String?
  eventId     BigInt?
  lastEventId BigInt?
  count       Int       @default(1)
  firstAt     DateTime
  lastAt      DateTime
  readAt      DateTime?
  /// The project was muted for the user when it arrived (D3).
  muted       Boolean   @default(false)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runner     Runner?                @relation(fields: [runnerId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@unique([eventId, userId, kind])
  @@index([userId, readAt, lastAt])
  @@index([userId, lastAt, id])
  /// The D6 fold lookup and the `queue.dry` interval.
  @@index([userId, kind, firstAt])
  @@map("notifications")
}

/// A user's choice for one kind (D3). No row: the D1 default.
model NotificationRule {
  userId    String
  kind      String
  inApp     Boolean
  telegram  Boolean
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
  @@map("notification_rules")
}

/// A user's mute of a project (D3). `until` null: until removed.
model NotificationMute {
  userId    String
  projectId String
  until     DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("notification_mutes")
}

enum NotificationDeliveryChannel {
  telegram
}

enum NotificationDeliveryStatus {
  pending
  sent
  digested
  failed
  skipped
}

/// One notification's delivery on an outside channel (D6). `digested`: over
/// the rate limit, sent inside the digest `digestId` once its window ends
/// (`nextAttemptAt`); `sentAt` is set when that digest went out. `skipped`:
/// never sent — `lastError` says why (shared `DeliverySkipReason`).
model NotificationDelivery {
  id             String                      @id @default(cuid())
  notificationId BigInt
  /// Denormalised from the notification for the per-user rate limit.
  userId         String
  channel        NotificationDeliveryChannel
  status         NotificationDeliveryStatus
  attempts       Int                         @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  digestId       String?
  sentAt         DateTime?
  createdAt      DateTime                    @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([userId, channel, sentAt])
  @@index([digestId])
  @@map("notification_deliveries")
}

/// The Telegram private chat a user linked (D9). One chat per user, one user per chat.
model TelegramLink {
  userId           String   @id
  chatId           BigInt   @unique
  username         String?
  linkedAt         DateTime @default(now())
  /// #500: the project the chat's Board commands act on (`/project`). Null
  /// until chosen; a deleted project clears it.
  currentProjectId String?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentProject Project?        @relation(fields: [currentProjectId], references: [id], onDelete: SetNull)
  intake         TelegramIntake?

  @@index([currentProjectId])
  @@map("telegram_links")
}

/// #574: the New work intake a linked chat runs with `/new` — one per link.
/// `planId` is null while the bot waits for the description. The rest is
/// what the chat shows of the plan: `shown` is the last state sent
/// (`<turn id>:<phase>`), the thinking message edited when a turn ends, and
/// the open round's question messages and the answers picked on them.
/// Deleted once the intake made its cards or was discarded.
model TelegramIntake {
  userId            String   @id
  chatId            BigInt
  projectId         String
  planId            String?  @unique
  shown             String?
  thinkingMessageId Int?
  /// The message with the open round's or proposal's buttons.
  controlsMessageId Int?
  /// `{ "<message id>": "<question id>" }` of the open round.
  questionMessages  Json     @default("{}")
  /// `{ "<question id>": { optionId?, optionIds?, text? } }` picked so far.
  answers           Json     @default("{}")
  /// #594: photos sent before the description, pending until the plan claims them.
  attachmentIds     String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  link    TelegramLink @relation(fields: [userId], references: [userId], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan    Plan?        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("telegram_intakes")
}

/// A one-time `/start <code>` link code (D9): 10 minutes, single use. Only the
/// SHA-256 of the code is stored.
model TelegramLinkCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("telegram_link_codes")
}

/// The single row (`id = 1`) of the notification loops' positions (D4, D7).
/// `eventsCursor`: every event with `id <=` it has been matched.
model NotificationMatcherState {
  id                   Int      @id @default(1)
  eventsCursor         BigInt
  telegramUpdateOffset BigInt   @default(0)
  updatedAt            DateTime @updatedAt

  @@map("notification_matcher_state")
}

/// A runner away for more than 5 minutes (D5). At most one open
/// (`resolvedAt` null) per runner; the watcher holds a lock while it decides.
model RunnerIncident {
  id         String    @id @default(cuid())
  runnerId   String
  openedAt   DateTime
  resolvedAt DateTime?

  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@index([runnerId, resolvedAt])
  @@map("runner_incidents")
}

/// The blocked-checkpoint sweep's memory of one blocked checkpoint (spec 22
/// note 23): which heading it is about, since when that heading stands, and
/// whether it notified. A new heading at the same position starts it over.
model BlockedCheckpointNotice {
  checkpointId String    @id
  heading      String
  since        DateTime
  notifiedAt   DateTime?

  checkpoint SlotCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@map("blocked_checkpoint_notices")
}

// ─── Activity feed and execution history (docs/specs/21) ────────────────────
// Projections of `events`, `audit_records` and `slots`, which are read only
// here. Rebuildable from their sources within the `events` retention.

enum ActivityCategory {
  fleet
  runner
  audit
}

enum ActivitySeverity {
  info
  ok
  warn
  danger
}

enum ActivityActorType {
  user
  runner
  orchestrator
  system
}

enum ActivitySourceKind {
  event
  audit
}

/// One curated feed item (D1, D3), from an `events` row (`sourceId` = its `id`)
/// or an `audit_records` row (`sourceId` = its `seq`). A replayed source row
/// hits the unique key and changes nothing (D2).
model ActivityItem {
  id         BigInt             @id @default(autoincrement())
  /// The source's own `ts`.
  ts         DateTime
  /// null: runner- or user-level, or the project is gone — admins only (D4).
  projectId  String?
  category   ActivityCategory
  type       String
  severity   ActivitySeverity
  title      String
  actorType  ActivityActorType
  /// User id or runner id; null for the orchestrator, the system, an unknown user.
  actorId    String?
  slot       String?
  issue      Int?
  prNumber   Int?
  link       String?
  /// A few safe fields of the source, ≤ 4 KB; never secrets.
  data       Json
  sourceKind ActivitySourceKind
  sourceId   BigInt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([sourceKind, sourceId])
  @@index([projectId, ts, id])
  @@index([ts, id])
  @@index([type, ts])
  @@map("activity_items")
}

/// Where the activity projector stopped (D2): one row, id `activity`.
/// `eventsCursor`: every `events.id` up to it was considered. `auditCursor`:
/// the same for `audit_records.seq`.
model ActivityProjectorState {
  id           String   @id
  eventsCursor BigInt   @default(0)
  auditCursor  BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  @@map("activity_projector_state")
}

enum RunKind {
  orchestrator_slot
  skill
  schedule
  /// A Planner turn (docs/specs/172 D14).
  plan
  /// A UI profile build (docs/specs/223 D13).
  ui_profile
  /// A board card round (issue #242 D4).
  card
  /// A card capture extraction (issue #244 D4).
  card_capture
  /// A text normalization (issue #271 D4, ADR-0027).
  text_normalize
  /// A card's model assessment (issue #322 D5, ADR-0032).
  card_assess
  /// Steward's local haiku: a stall's classification or the digest prose
  /// (issue #447 D3, D16).
  steward
}

enum RunStatus {
  running
  blocked
  waiting_person
  succeeded
  failed
  abandoned
}

enum RunOutput {
  report
  pr
}

enum RunTrigger {
  orchestrator
  user
  schedule
  webhook
  /// Card capture after a manual session idles or ends (issue #244 D2).
  capture
}

/// One unit of agent work (D7, data-model.md). An `orchestrator_slot` run is a
/// pure function of its slot, rebuilt whenever the slot's `lastSeq` passes
/// `slotSeq`. Tokens and cost are computed on read (D8).
model Run {
  id                 String     @id @default(cuid())
  kind               RunKind
  projectId          String
  slotId             String?    @unique
  issue              Int?
  title              String?
  runtime            Runtime?
  model              String?
  profileKey         String?
  args               Json?
  output             RunOutput?
  status             RunStatus
  /// The last checkpoint's summary.
  outcome            String?
  prNumber           Int?
  prUrl              String?
  triggeredByType    RunTrigger
  triggeredById      String?
  startedAt          DateTime
  endedAt            DateTime?
  durationMs         Int?
  /// The slot's `lastSeq` this row was built from; null for other kinds.
  slotSeq            BigInt?
  /// The slot's `updatedAt` (event time) for a slot run, so a rebuild from the
  /// same slot is identical.
  updatedAt          DateTime
  /// #445 D8: the finish was accepted after the artifact guard's 2 rejections —
  /// the card shows "Description incomplete".
  artifactIncomplete Boolean    @default(false)
  /// #445 D12: the launch carried `tokenSaver.enabled`. The before/after
  /// compares runs with `false` against runs with `true`, by kind.
  tokenSaver         Boolean    @default(false)

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slot              Slot?              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  skillRun          SkillRun?
  planTurn          PlanTurn?
  uiProfiles        UiProfile[]
  firings           ScheduleFiring[]
  cardRound         BoardCardRound?
  cardCapture       CardCapture?
  textNormalization TextNormalization?
  inboundDeliveries InboundDelivery[]
  tokenSaverStats   TokenSaverStat[]

  @@index([projectId, startedAt])
  @@index([projectId, status])
  @@map("runs")
}

/// Skills (docs/specs/24).
enum SkillScope {
  project
  profile
  plugin
}

/// A skill run's phase on the runner (D12); `runs.status` follows it.
enum SkillRunPhase {
  queued
  preparing
  running
  collecting
  succeeded
  failed
  cancelled
  timed_out
}

/// The skills a runner's last `skill.list` found (D6) — a cache, replaced per
/// scan. Project rows carry `projectId`; profile and plugin rows `profileKey`.
/// One of the two is always null, so the unique below cannot dedupe on its own
/// (Postgres NULLs are distinct): the scan replaces rows in one transaction.
model InstalledSkill {
  id            String     @id @default(cuid())
  runnerId      String
  projectId     String?
  profileKey    String?
  scope         SkillScope
  runtime       Runtime
  name          String
  /// `<name>`, or `<plugin>:<name>` for a plugin skill (D8).
  invocation    String
  path          String
  description   String?
  argumentHint  String?
  /// From `.agentdock-skill.json` (D5); null on hand-written skills.
  source        String?
  commit        String?
  contentHash   String?
  pluginVersion String?
  seenAt        DateTime

  runner  Runner   @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([runnerId, scope, projectId, profileKey, runtime, name])
  @@index([projectId])
  @@map("installed_skills")
}

/// One inspected skill (D2), installable once by the user who inspected it
/// until `expiresAt`. Install re-checks `contentHash` on the runner (D3).
model SkillInstallPreview {
  id          String    @id @default(cuid())
  runnerId    String
  projectId   String?
  userId      String
  source      String
  skillId     String
  commit      String
  contentHash String
  files       Json
  frontmatter Json
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?

  runner  Runner   @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("skill_install_previews")
}

/// The skill-specific half of a `runs` row of kind `skill` (D12). Only the D10
/// report fields are stored; the stream stays on the runner (D13).
model SkillRun {
  runId             String                     @id
  /// The invocation (`code-sentinel:spec`).
  skill             String
  args              String
  profileKey        String
  model             String
  permissionMode    OrchestratorPermissionMode
  output            RunOutput
  phase             SkillRunPhase              @default(queued)
  worktree          String?
  branch            String?
  tmuxSession       String?
  timeoutSec        Int
  exitCode          Int?
  reportText        String?
  reportTruncated   Boolean                    @default(false)
  changedFiles      Json?
  changedFilesTotal Int?
  /// `git diff` against the base, at most 128 KiB; the full patch stays on the runner.
  patch             String?
  patchTruncated    Boolean                    @default(false)
  error             String?
  prNumber          Int?
  prUrl             String?
  queuedAt          DateTime                   @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([phase])
  @@map("skill_runs")
}

// ─── Merge approval queue (docs/specs/20-merge-approval-queue.md) ───────────

/// `orchestrator`: the plugin emitted `pr.awaiting_approval`; `derived`: D2's fallback.
enum ApprovalSource {
  orchestrator
  derived
}

enum ApprovalStatus {
  waiting
  approved
  changes_requested
  stale
  merged
  closed
}

/// The approval state of one pull request at one head. At most one row per
/// PR is current (`waiting` | `approved`), enforced by the approvals module
/// under a per-project advisory lock; the rest are history. `headSha` is null
/// until a decision binds the row to a head (spec 20 notes, Q3).
model MergeApproval {
  id           String         @id @default(cuid())
  projectId    String
  prNumber     Int
  slot         String?
  issue        Int?
  headSha      String?
  source       ApprovalSource
  status       ApprovalStatus
  /// Nullable so deleting the user keeps the decision.
  decidedById  String?
  decidedAt    DateTime?
  /// D7: the request-changes note.
  note         String?
  waitingSince DateTime
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([projectId, prNumber])
  @@index([projectId, status])
  @@map("merge_approvals")
}

// ─── Webhooks (docs/specs/26-webhooks.md) ───────────────────────────────────

/// What became of one inbound delivery (D2–D7). `accepted`: verified and
/// recorded, the command not sent yet; `started`: the command was accepted and
/// `runId` is set; `skipped`: D6's one live run; `rejected`: refused after it
/// was recorded (`reason`); `failed`: the firing failed (`reason`).
enum InboundDeliveryStatus {
  accepted
  skipped
  rejected
  started
  failed
}

enum WebhookDeliveryStatus {
  pending
  succeeded
  failed
}

/// D14.
enum WebhookCircuitState {
  closed
  open
  half_open
}

/// A signed `POST /hooks/<publicId>` that starts work on one project (D1–D6).
/// `secret` / `previousSecret` are `SecretCipher` ciphertext (D17); the
/// previous one verifies until `previousSecretUntil`. `bucketTokens` /
/// `bucketRefilledAt` are D6's per-trigger token bucket.
model InboundTrigger {
  id                  String    @id @default(cuid())
  /// D1: 24 random characters, the URL's id — never the cuid.
  publicId            String    @unique
  name                String
  projectId           String
  /// D3's closed union (shared `inboundTriggerActionSchema`).
  action              Json
  /// D4: the `payload.<path>`s the action's args may reference.
  allowedPaths        String[]
  /// D4: null means the shared default pattern.
  valuePattern        String?
  secret              String
  previousSecret      String?
  previousSecretUntil DateTime?
  enabled             Boolean   @default(true)
  disabledReason      String?
  bucketTokens        Int
  bucketRefilledAt    DateTime
  /// Nullable so deleting the admin keeps the trigger; a null creator is
  /// `creator_not_authorized` at fire time (D5).
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deliveries InboundDelivery[]

  @@index([projectId])
  @@map("inbound_triggers")
}

/// One received inbound delivery, and D2's nonce store: `(triggerId,
/// deliveryId)` is unique, kept 24 hours for replay detection and 30 days in
/// all (D18).
model InboundDelivery {
  id           BigInt                @id @default(autoincrement())
  triggerId    String
  /// The caller's `X-AgentDock-Delivery`, at most 64 characters.
  deliveryId   String
  receivedAt   DateTime              @default(now())
  status       InboundDeliveryStatus
  reason       String?
  renderedArgs Json?
  runId        String?
  commandRunId String?
  sourceIp     String?

  trigger InboundTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  run     Run?           @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([triggerId, deliveryId])
  @@index([triggerId, receivedAt])
  @@index([receivedAt])
  @@map("inbound_deliveries")
}

/// An outbound target (D9–D15). `events` ⊆ the shared catalogue; `projectIds`
/// empty means every project. `secret` is `SecretCipher` ciphertext (D17).
model Webhook {
  id                  String              @id @default(cuid())
  name                String
  url                 String
  events              String[]
  projectIds          String[]
  secret              String
  enabled             Boolean             @default(true)
  circuitState        WebhookCircuitState @default(closed)
  circuitOpenedAt     DateTime?
  consecutiveFailures Int                 @default(0)
  /// Nullable so deleting the admin keeps the webhook.
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

/// One event's delivery to one webhook (D11, D12). `eventId` is null for a
/// `webhook.test` delivery; `(webhookId, eventId)` makes the dispatcher
/// idempotent. `responseBody` holds at most 2 KB.
model WebhookDelivery {
  id            String                @id @default(cuid())
  webhookId     String
  eventId       BigInt?
  eventType     String
  /// The D10 envelope, signed anew on every attempt.
  payload       Json
  status        WebhookDeliveryStatus @default(pending)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now())
  lastAttemptAt DateTime?
  responseCode  Int?
  responseBody  String?
  error         String?
  createdAt     DateTime              @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([webhookId, eventId])
  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

/// Where the outbound dispatcher stopped (D11): one row, id `webhooks`.
/// Every `events.id` up to `eventsCursor` was considered.
model WebhookDispatcherState {
  id           String   @id
  eventsCursor BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  @@map("webhook_dispatcher_state")
}

// ─── Cron schedules (docs/specs/25-cron-schedules.md) ───────────────────────

enum ScheduleMissedPolicy {
  skip
  catch_up
}

enum ScheduleDisabledReason {
  manual
  failing
  creator_not_authorized
}

enum ScheduleFiringKind {
  cron
  catch_up
  manual
}

enum ScheduleFiringStatus {
  due
  started
  noop
  skipped
  failed
  succeeded
}

/// A skill run or an orchestrator start fired at the times of `cron` in
/// `timezone` (D1–D4). The scheduler claims rows by `(enabled, nextRunAt)`.
model Schedule {
  id                  String                  @id @default(cuid())
  projectId           String
  name                String
  /// D1: `{ kind: "skill", … }` or `{ kind: "orchestrator", mode }`.
  target              Json
  cron                String
  /// An IANA name; fire times are stored in UTC (D4).
  timezone            String
  missedPolicy        ScheduleMissedPolicy    @default(skip)
  enabled             Boolean                 @default(true)
  disabledReason      ScheduleDisabledReason?
  /// Null while disabled.
  nextRunAt           DateTime?               @db.Timestamptz(3)
  lastRunAt           DateTime?               @db.Timestamptz(3)
  /// D11: failed firings since the last succeeded one.
  consecutiveFailures Int                     @default(0)
  /// A schedule acts with its creator's authority (D10); it goes with them.
  createdById         String
  updatedById         String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User             @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedBy User?            @relation("ScheduleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  firings   ScheduleFiring[]

  @@index([enabled, nextRunAt])
  @@index([projectId])
  @@map("schedules")
}

/// One occurrence of a schedule (D5–D9, D15). The unique key keeps an
/// occurrence from firing twice, whichever instance claims it.
model ScheduleFiring {
  id           BigInt               @id @default(autoincrement())
  scheduleId   String
  scheduledFor DateTime             @db.Timestamptz(3)
  firedAt      DateTime?            @db.Timestamptz(3)
  kind         ScheduleFiringKind
  status       ScheduleFiringStatus
  reason       String?
  /// D6: the missed occurrences a `skipped` row stands for.
  missedCount  Int                  @default(0)
  /// The run a skill firing started (#21); runs outlive the schedule.
  runId        String?
  /// The `command_runs` row an orchestrator firing wrote (#17).
  commandRunId String?
  /// D-10: the person the firing ran as — the owner for a timed firing, the
  /// caller for run now; its spend is theirs. Null until the firing is sent.
  principalId  String?
  error        Json?
  finishedAt   DateTime?            @db.Timestamptz(3)

  schedule  Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  run       Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  principal User?    @relation("ScheduleFiringPrincipal", fields: [principalId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, scheduledFor, kind])
  @@index([scheduleId, scheduledFor])
  @@index([status])
  @@map("schedule_firings")
}

// ─── Budgets (docs/specs/28-budgets.md) ─────────────────────────────────────

enum BudgetScope {
  project
  user
}

enum BudgetPeriod {
  day
  week
  month
}

enum BudgetAction {
  alert
  stop
}

/// A spend cap in API-equivalent dollars (D1). Exactly one of `projectId` /
/// `userId` is set, matching `scope` (check constraint `budgets_scope_check`),
/// and at most one budget per `(scope, projectId, userId, period)` is enabled
/// (partial unique index `budgets_enabled_key`). Both live in the migration's
/// SQL: Prisma cannot declare either.
model Budget {
  id          String       @id @default(cuid())
  scope       BudgetScope
  projectId   String?
  userId      String?
  period      BudgetPeriod
  /// IANA zone the periods are cut in (D9).
  timezone    String
  limitUsd    Decimal      @db.Decimal(14, 4)
  /// Sorted percents, 100 always present.
  thresholds  Int[]
  action      BudgetAction
  enabled     Boolean      @default(true)
  /// Nullable so deleting the admin who created it keeps the budget.
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?             @relation("BudgetUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("BudgetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  periods   BudgetPeriodRow[]
  overrides BudgetOverride[]

  @@index([projectId])
  @@index([userId])
  @@map("budgets")
}

/// One period of a budget, `[start, end)` (D9). `spentUsd` and
/// `unpricedRequests` are rebuilt from `llm_requests` on every evaluation
/// (spec 28 notes, amending D4/D5); `firedThresholds` only grows within the
/// period, so each threshold notifies once.
model BudgetPeriodRow {
  id               String    @id @default(cuid())
  budgetId         String
  start            DateTime  @db.Timestamptz(3)
  end              DateTime  @db.Timestamptz(3)
  spentUsd         Decimal   @default(0) @db.Decimal(14, 6)
  unpricedRequests Int       @default(0)
  firedThresholds  Int[]     @default([])
  exceededAt       DateTime? @db.Timestamptz(3)
  reconciledAt     DateTime  @db.Timestamptz(3)

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, start])
  @@map("budget_periods")
}

/// An admin lifting a `stop` budget for one period, until `until` (D8).
model BudgetOverride {
  id          String    @id @default(cuid())
  budgetId    String
  periodStart DateTime  @db.Timestamptz(3)
  until       DateTime  @db.Timestamptz(3)
  reason      String
  /// Nullable so deleting the admin keeps the record.
  byId        String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime? @db.Timestamptz(3)
  revokedById String?

  budget    Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  by        User?  @relation("BudgetOverrideBy", fields: [byId], references: [id], onDelete: SetNull)
  revokedBy User?  @relation("BudgetOverrideRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([budgetId, periodStart])
  @@map("budget_overrides")
}

// ─── GitHub App (spec 27) ───────────────────────────────────────────────────

/// The one GitHub App of this instance (D1, D3). Secrets are `SecretCipher`
/// ciphertext and never leave the API.
model GitHubApp {
  /// Always "app": one App per instance.
  id                     String    @id @default("app")
  appId                  Int
  slug                   String
  ownerLogin             String
  privateKey             String
  webhookSecret          String
  /// Stored, unused: AgentDock does no OAuth (D3).
  clientSecret           String?
  /// False when the manifest had no `PUBLIC_URL` (D14).
  hookActive             Boolean
  signatureFailures      Int       @default(0)
  lastDeliveryAt         DateTime?
  /// D11 (c): a failure after the last verified delivery makes every project unhealthy.
  lastSignatureFailureAt DateTime?
  /// D11 (b): the last `GET /app/hook/deliveries` check, at resync.
  hookCheckedAt          DateTime?
  hookCheckOk            Boolean?
  /// Nullable so deleting the admin keeps the registration.
  registeredById         String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  registeredBy User? @relation(fields: [registeredById], references: [id], onDelete: SetNull)

  @@map("github_app")
}

/// An installation of the App, as GitHub last listed it (D10).
model GitHubInstallation {
  /// GitHub's installation id.
  id           Int      @id
  accountLogin String
  accountType  String
  suspended    Boolean
  syncedAt     DateTime
  createdAt    DateTime @default(now())

  repos GitHubInstallationRepo[]

  @@map("github_installations")
}

/// A repository an installation can see. `fullName` is lower-cased (D7).
model GitHubInstallationRepo {
  installationId Int
  /// BigInt: GitHub's repository ids are nearing the 32-bit limit.
  repoId         BigInt
  fullName       String

  installation GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@id([installationId, repoId])
  @@index([fullName])
  @@map("github_installation_repos")
}

/// A verified delivery, kept for dedupe by `X-GitHub-Delivery` (D6) and for
/// D11's "recent delivery"; 14 days (D17).
model GitHubDelivery {
  deliveryId      String   @id
  event           String
  action          String?
  /// Lower-cased `repository.full_name`.
  fullName        String?
  installationId  Int?
  receivedAt      DateTime @default(now())
  handled         Boolean
  projectsMatched Int

  @@index([installationId, receivedAt])
  @@index([receivedAt])
  @@map("github_deliveries")
}

/// A project's App health, recomputed every 5 minutes (D11).
model GitHubProjectHealth {
  projectId String   @id
  covered   Boolean
  /// `healthy` | `unhealthy` (shared `githubAppHealthSchema`).
  state     String
  reason    String?
  checkedAt DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("github_project_health")
}

// ─── Planner (spec 172) ─────────────────────────────────────────────────────

/// Shared `PLAN_MODES` (D2; `card`: #337 D1, a New Card intake; `discuss`:
/// #590, a discussion, ADR-0056).
enum PlanMode {
  batch
  dialogue
  card
  discuss
}

/// Shared `PLAN_VISIBILITIES` (D12).
enum PlanVisibility {
  private
  project
}

/// Shared `PLAN_STATUSES` (`done`: #337 D6, a plan that made its cards).
enum PlanStatus {
  clarifying
  drafting
  reviewing
  sending
  sent
  archived
  done
}

/// Shared `PLAN_TASK_KINDS` (D4).
enum PlanTaskKind {
  bug
  feature
}

/// Shared `PLAN_TASK_STATUSES` (D6, D9; `needs_design`: spec 223 D1).
enum PlanTaskStatus {
  draft
  needs_talk
  needs_design
  ready
  approved
  rejected
  rewrite_requested
  issued
}

/// Shared `PLAN_TURN_ACTIONS` (D16; `design`: spec 223 D7; `intake`: #337 D1;
/// `discuss`: #590).
enum PlanTurnAction {
  decompose
  clarify
  grill
  write
  revise
  design
  intake
  discuss
}

/// Shared `PLAN_TURN_PHASES`.
enum PlanTurnPhase {
  queued
  running
  succeeded
  failed
  cancelled
}

/// Shared `PLANNER_SPEC_OUTPUTS` (D10).
enum PlannerSpecOutput {
  docs_pr
  issue_body
}

/// The planner's instructions, one row per saved version (D11, ADR-0019).
/// `projectId` null is the global default; a project row is that project's
/// override. Unique `(projectId, version)`, and — Postgres treating NULLs as
/// distinct — a partial unique index on `version` for the global rows (in the
/// migration).
model PlannerInstructions {
  id        String   @id @default(cuid())
  projectId String?
  version   Int
  body      String
  /// Null for the seeded version 1, and when the author is deleted.
  authorId  String?
  createdAt DateTime @default(now())

  project    Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  plans      Plan[]
  overrideOf PlannerSettings[]

  @@unique([projectId, version])
  @@map("planner_instructions")
}

/// A project's planner settings (D10). No row: `docs_pr` when the project has
/// a `specDir`, `issue_body` otherwise.
model PlannerSettings {
  projectId              String            @id
  specOutput             PlannerSpecOutput
  /// The project's instructions override, a project version; null: the latest
  /// global version applies. Clearing sets null and keeps every version (D11).
  overrideInstructionsId String?
  /// Nullable so deleting the admin keeps the settings.
  updatedById            String?
  updatedAt              DateTime          @updatedAt

  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  overrideInstructions PlannerInstructions? @relation(fields: [overrideInstructionsId], references: [id], onDelete: SetNull)
  updatedBy            User?                @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("planner_settings")
}

/// A plan: a brief and its tasks, across versions (D1, D9). One Claude
/// session per plan (`sessionId`, D3); its read-only worktree (D15).
model Plan {
  id               String         @id @default(cuid())
  projectId        String
  /// Nullable so deleting the author keeps a sent plan's record; a private
  /// plan without an author is readable by nobody (D12).
  authorId         String?
  title            String
  brief            String
  mode             PlanMode
  visibility       PlanVisibility @default(private)
  status           PlanStatus
  version          Int            @default(1)
  sessionId        String         @db.Uuid
  /// The instructions version the plan runs with (D11).
  instructionsId   String
  contractVersion  Int
  profileKey       String
  model            String
  worktree         String?
  docsPrNumber     Int?
  docsPrUrl        String?
  /// #379: `owner/name` of the docs repository the docs PR is in; null when
  /// it is the project's own repository.
  docsPrRepo       String?
  /// #379: with an external docs repository, the approved designs stay in the
  /// code repository, in a PR of their own (spec 223 D16 fallback directory).
  designPrNumber   Int?
  designPrUrl      String?
  /// #379: when each PR was seen merged; the issues waiting on it queue then.
  docsPrMergedAt   DateTime?
  designPrMergedAt DateTime?
  /// #592 (ADR-0058): the stack the intake proposed — `{title, body, design,
  /// stages: string[]}` (shared `planCandidateStackSchema`); its candidates
  /// name their stage by index. Null for one card or a split.
  candidateStack   Json?
  /// #590: a discussion's skills, installed invocations every turn applies;
  /// empty for any other mode.
  skills           String[]       @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sentAt           DateTime?

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author             User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  instructions       PlannerInstructions @relation(fields: [instructionsId], references: [id], onDelete: Restrict)
  tasks              PlanTask[]
  turns              PlanTurn[]
  designs            TaskDesign[]
  textNormalizations TextNormalization[]
  /// #337 D6, D7: the board cards this plan made.
  cards              BoardCard[]
  /// #337 D6, D10: an intake's attachments, held until its card claims them.
  attachments        Attachment[]
  /// #480: the stacks a confirmed intake made.
  stacks             BoardStack[]
  /// #574: the Telegram chat running this intake.
  telegramIntake     TelegramIntake?
  /// #592 (ADR-0058): the cards the intake wrote, waiting for the person.
  candidates         PlanCandidate[]

  @@index([projectId, updatedAt])
  @@index([authorId])
  @@map("plans")
}

/// A task of one plan version (D4, D9). `key` is stable across versions;
/// approved tasks are carried into the next version `frozen`. After it is
/// issued, its live status is derived, never stored ("Data / Schema").
model PlanTask {
  id             String         @id @default(cuid())
  planId         String
  /// Stable within the plan (`t3`); `dependsOn` holds keys.
  key            String
  planVersion    Int
  kind           PlanTaskKind
  title          String
  summary        String
  dependsOn      String[]       @default([])
  status         PlanTaskStatus @default(draft)
  /// The current round's `PlanQuestion[]` (shared `planQuestionSchema`).
  questions      Json           @default("[]")
  document       String?
  rewriteComment String?
  frozen         Boolean        @default(false)
  /// The fork of the plan session this task's conversation runs in (D3).
  sessionId      String?        @db.Uuid
  issueNumber    Int?
  issueUrl       String?
  queuedAt       DateTime?
  /// #337 D7: the board card Create cards made from this task.
  cardId         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  plan               Plan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  card               BoardCard?          @relation("PlanTaskCard", fields: [cardId], references: [id], onDelete: SetNull)
  turns              PlanTurn[]
  textNormalizations TextNormalization[]

  @@unique([planId, key, planVersion])
  @@index([planId, planVersion])
  @@index([issueNumber])
  @@map("plan_tasks")
}

/// One headless turn (D3, D17): a `runs` row of kind `plan` (D14). A turn
/// whose output fails the contract keeps `resultText` and applies nothing.
/// Shared `PLAN_CANDIDATE_STATUSES` (#592, ADR-0058).
enum PlanCandidateStatus {
  pending
  accepted
  rejected
}

/// #592 (ADR-0058): a card a New work intake wrote, waiting in Drafts until
/// the person accepts it (a board card is made) or rejects it.
model PlanCandidate {
  id          String              @id @default(cuid())
  planId      String
  /// 0-based, in the proposal's order (stage order for a stack).
  position    Int
  /// English, at most `CARD_DRAFT_TITLE_MAX` characters.
  title       String
  kind        PlanTaskKind
  /// Markdown, at most `CARD_DRAFT_BODY_MAX` characters.
  body        String
  /// The 0-based stage of `plans.candidateStack` it was proposed in.
  stage       Int?
  status      PlanCandidateStatus @default(pending)
  /// Bumped by every edit: an edit or accept naming an older one is stale.
  version     Int                 @default(1)
  /// The card Accept made.
  cardId      String?             @unique
  /// How many of the intake's attachments its card took (ADR-0037 §4).
  attachments Int                 @default(0)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  card      BoardCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  decidedBy User?      @relation("PlanCandidateDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([planId, position])
  @@map("plan_candidates")
}

model PlanTurn {
  id         String         @id @default(cuid())
  /// Exactly one of `planId` / `cardId` / `stackId` (CHECK `plan_turns_owner_check`, ADR-0025, ADR-0044).
  planId     String?
  /// A board card's design turn (#243 D2), sent as `plan.turn` with `planId = card.id`.
  cardId     String?
  /// #480: a stack's design turn, sent as `plan.turn` with `planId = stack.id`.
  stackId    String?
  /// Set for a task's grill or write turn.
  taskId     String?
  runId      String         @unique
  action     PlanTurnAction
  /// Nullable so deleting the author keeps the turn.
  authorId   String?
  /// `{ message?, answers? }` (shared `planTurnInputSchema`).
  input      Json
  /// The validated contract output.
  output     Json?
  resultText String?
  phase      PlanTurnPhase  @default(queued)
  error      String?
  createdAt  DateTime       @default(now())
  finishedAt DateTime?

  plan               Plan?               @relation(fields: [planId], references: [id], onDelete: Cascade)
  card               BoardCard?          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  stack              BoardStack?         @relation(fields: [stackId], references: [id], onDelete: Cascade)
  task               PlanTask?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run                Run                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  author             User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  designRevisions    DesignRevision[]
  textNormalizations TextNormalization[]

  @@index([planId, createdAt])
  @@index([cardId, createdAt])
  @@index([stackId, createdAt])
  @@index([taskId, createdAt])
  @@map("plan_turns")
}

// ─── Design stage (spec 223) ────────────────────────────────────────────────

/// Shared `UI_PROFILE_SOURCES` (D14).
enum UiProfileSource {
  agent
  manual
}

/// Shared `TASK_DESIGN_STATUSES`.
enum TaskDesignStatus {
  idle
  generating
  reviewing
  revising
  approved
}

/// Shared `DESIGN_COMMENT_KINDS` (D9).
enum DesignCommentKind {
  general
  screen
  pin
}

/// Shared `DESIGN_THEMES`.
enum DesignTheme {
  light
  dark
}

/// A project's UI profile, one row per version (D12). An agent version is
/// built by a `ui_profile` run; a manual one is a person's edit, whose diff
/// the next build keeps as `obligations` (D14).
model UiProfile {
  id               String          @id @default(cuid())
  projectId        String
  version          Int
  source           UiProfileSource
  hasUi            Boolean
  /// Markdown: libraries, styling, tokens, components, patterns, themes, icons.
  summary          String
  /// The style kit's CSS (at most `UI_PROFILE_KIT_MAX_BYTES`).
  kit              String
  /// `[{ name, html }]` (shared `uiProfileSnippetSchema`).
  snippets         Json            @default("[]")
  fingerprintGlobs String[]        @default([])
  /// SHA-256 hex of the files matching `fingerprintGlobs` on `origin/<base>`.
  fingerprint      String
  /// The manual edits this build was told to keep (D14).
  obligations      String?
  /// The build's run; null for a manual version.
  runId            String?
  /// The person behind a manual version; null for an agent build.
  authorId         String?
  createdAt        DateTime        @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run     Run?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  author  User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  designs TaskDesign[]

  @@unique([projectId, version])
  @@map("ui_profiles")
}

/// A project's design settings (D11, D15). No row: the default viewports and
/// no default skills.
model DesignSettings {
  projectId     String   @id
  /// `[{ name, width, height, theme? }]` (shared `viewportPresetsSchema`).
  viewports     Json
  defaultSkills String[] @default([])
  updatedById   String?
  updatedAt     DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("design_settings")
}

/// A task's design, keyed by `(planId, taskKey)` — not by a `plan_tasks` row,
/// which is versioned per plan version while the design carries across them.
/// A design has exactly one owner (ADR-0025): a plan task (`planId` and
/// `taskKey`) or a board card (`cardId`) — CHECK `task_designs_owner_check`.
model TaskDesign {
  id                 String           @id @default(cuid())
  planId             String?
  taskKey            String?
  cardId             String?          @unique
  /// #480 (ADR-0044): a stack's shared design, drawn for the whole result.
  stackId            String?          @unique
  /// The person's switch (D2); starts as the planner's suggestion.
  needed             Boolean
  /// Whether the planner suggested it, and why (D2).
  suggested          Boolean          @default(false)
  suggestionWhy      String?
  /// 1–3 (D4), checked by the DTO and the contract.
  variantCount       Int              @default(1)
  skills             String[]         @default([])
  /// The profile version the latest revisions were drawn from.
  profileId          String?
  status             TaskDesignStatus @default(idle)
  approvedRevisionId String?          @unique
  approvedById       String?
  approvedAt         DateTime?
  /// #275 D2: when the current Generate or Revise started; null at rest.
  busySince          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  plan             Plan?            @relation(fields: [planId], references: [id], onDelete: Cascade)
  card             BoardCard?       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  stack            BoardStack?      @relation(fields: [stackId], references: [id], onDelete: Cascade)
  profile          UiProfile?       @relation(fields: [profileId], references: [id], onDelete: SetNull)
  approvedRevision DesignRevision?  @relation("TaskDesignApprovedRevision", fields: [approvedRevisionId], references: [id], onDelete: SetNull)
  approvedBy       User?            @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  revisions        DesignRevision[] @relation("TaskDesignRevisions")
  comments         DesignComment[]

  @@unique([planId, taskKey])
  @@map("task_designs")
}

/// One revision of one variant of a design (D4, D10): the HTML a design turn
/// drew. A variant not picked on approve is `archived` — readable, never
/// published.
model DesignRevision {
  id        String   @id @default(cuid())
  designId  String
  /// 1–3.
  variant   Int
  revision  Int
  title     String
  rationale String
  /// The one validated mockup of a revision stored before #441, without the
  /// pin helper; it reads as a single frame named `Mockup`. Null on a revision
  /// with frames (`design_frames`).
  html      String?
  turnId    String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  design            TaskDesign      @relation("TaskDesignRevisions", fields: [designId], references: [id], onDelete: Cascade)
  turn              PlanTurn        @relation(fields: [turnId], references: [id], onDelete: Cascade)
  approvedFor       TaskDesign?     @relation("TaskDesignApprovedRevision")
  frames            DesignFrame[]
  comments          DesignComment[] @relation("DesignCommentRevision")
  addressedComments DesignComment[] @relation("DesignCommentAddressedIn")

  @@unique([designId, variant, revision])
  @@index([turnId])
  @@map("design_revisions")
}

/// #441: one named, separately rendered mockup of a revision. A revision's
/// frames keep the order the turn drew them in; together at most
/// `DESIGN_HTML_MAX_BYTES`, without the pin helper.
model DesignFrame {
  id         String @id @default(cuid())
  revisionId String
  /// 0-based.
  position   Int
  name       String
  /// The published file's stem, distinct within the revision.
  slug       String
  html       String

  revision DesignRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, position])
  @@map("design_frames")
}

/// A comment on a design (D9): general, on one screen (viewport and theme),
/// or pinned to a point. It records the revision it was left on and the one
/// that addressed it (D10).
model DesignComment {
  id                    String            @id @default(cuid())
  designId              String
  revisionId            String
  /// #441: the position of the frame it was left on; 0 for a comment made
  /// before frames, on the revision's one mockup.
  frame                 Int               @default(0)
  /// Nullable so deleting the author keeps the comment.
  authorId              String?
  kind                  DesignCommentKind
  /// A viewport preset's name; `screen` and `pin`.
  viewport              String?
  theme                 DesignTheme?
  /// Document coordinates of a pin.
  x                     Float?
  y                     Float?
  /// The CSS path of the element under a pin.
  selector              String?
  body                  String
  addressedInRevisionId String?
  createdAt             DateTime          @default(now())

  design      TaskDesign      @relation(fields: [designId], references: [id], onDelete: Cascade)
  revision    DesignRevision  @relation("DesignCommentRevision", fields: [revisionId], references: [id], onDelete: Cascade)
  author      User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  addressedIn DesignRevision? @relation("DesignCommentAddressedIn", fields: [addressedInRevisionId], references: [id], onDelete: SetNull)

  textNormalizations TextNormalization[]

  @@index([designId, createdAt])
  @@index([revisionId])
  @@map("design_comments")
}

// ─── Board (issue #242, ADR-0024) ───────────────────────────────────────────

/// Shared `BOARD_COLUMNS` (D3). `inbox` holds captured suggestions (#244 D8).
enum BoardColumn {
  inbox
  todo
  in_progress
  finished
  completed
}

/// Shared `BOARD_CARD_KINDS`: the branch prefix and the issue label.
enum BoardCardKind {
  feature
  bug
}

/// Shared `CARD_KIND_SOURCES` (#271 D9).
enum CardKindSource {
  auto
  person
}

/// Shared `BOARD_CARD_SOURCES`.
enum BoardCardSource {
  manual
  /// From card capture (#244); kept after Accept.
  captured
  /// From `track_card` in a person's own terminal session (#282 D1).
  terminal
  /// The mirror of an orchestrator slot or a `cs:ready` issue (#282 D4).
  fleet
}

/// Shared `CARD_ROUND_TRIGGERS` (D4).
enum CardRoundTrigger {
  run
  feedback
  /// #359 D6: started by AgentDock for a red check or a merge conflict.
  ci_fix
}

/// Shared `CARD_ROUND_PHASES` (D4, D6).
enum CardRoundPhase {
  queued
  starting
  running
  waiting
  /// #390 (ADR-0038): the turn stopped with its own background tasks running.
  background
  finished
  ended
  failed
  cancelled
}

/// Shared `CARD_FINISHED_BY` (D6).
enum CardFinishedBy {
  worker
  session_end
  person
}

/// Shared `CARD_COLLECT_STATES` (#329 D2): how the card's last `card.collect` went.
enum CardCollectState {
  /// Never collected.
  none
  /// A collect is running now.
  pending
  /// A PR was opened or is already open (`prUrl` set).
  ok
  /// `ahead: 0` — nothing to push.
  no_changes
  /// The runner failed it; `collectError` says why.
  failed
}

/// Shared `CARD_PR_STATES` (#329 D6): the card's PR as last seen.
enum CardPrState {
  open
  draft
  merged
  closed
}

/// Shared `CARD_CI_STATES` (#359 D5): the checks on the card's PR head.
enum CardCiState {
  /// No PR, or the head has no checks.
  none
  pending
  green
  red
}

/// A work item AgentDock owns (ADR-0024), not a GitHub issue. Each Run or
/// feedback is a round with its own `runs` row (D4).
model BoardCard {
  id                      String           @id @default(cuid())
  projectId               String
  /// Per project, `C-<number>`: max + 1 under `pg_advisory_xact_lock` (D1).
  number                  Int
  /// `^[a-z0-9]{8}$`: the worktree, tmux session and runner record (D5).
  shortId                 String           @unique
  /// At most 200 characters, checked by the DTO.
  title                   String
  /// Markdown, at most 20 000 characters.
  body                    String           @default("")
  kind                    BoardCardKind    @default(feature)
  /// #271 D9: `auto` lets the normalization classify `kind` until the first
  /// Run fixes the branch; a person setting kind makes it `person`.
  kindSource              CardKindSource   @default(auto)
  column                  BoardColumn      @default(todo)
  /// Fractional index inside the column (D3).
  position                Float
  source                  BoardCardSource  @default(manual)
  issueOnRun              Boolean
  specOnRun               Boolean
  /// Overrides the project's model from the next round (D12). #322 D3: the
  /// work model override, stored only when it differs from the default.
  model                   String?
  /// #322 D3: the Claude profile the person chose, shared by work and design;
  /// stored only when it differs from the resolver's pick.
  profileKey              String?
  /// #322 D3: the design turns' model override; stored only when it differs
  /// from the design recommendation, else the project's model.
  designModel             String?
  /// #322 D6: the recommended work model (`opus | sonnet | haiku`) and its
  /// one-line reason, from the last applied `card.assess`.
  recommendedModel        String?
  recommendedReason       String?
  /// #322 D6: the recommended design model (`opus | sonnet`) and its reason.
  recommendedDesignModel  String?
  recommendedDesignReason String?
  /// #322 D6: the hash of the assessed input; an answer applies only while
  /// the card still hashes to it (ADR-0027 D4).
  assessmentHash          String?
  /// When the last recommendation was applied.
  assessedAt              DateTime?
  /// The `runs` row of the last `card.assess` call.
  assessRunId             String?
  /// #243 D5: approving the design starts round 1. Changeable until the design is approved.
  continueAfterDesign     Boolean          @default(false)
  /// #243 D2: the design turns' Claude session — `--session-id` first, then `--resume`.
  designSessionId         String?          @db.Uuid
  /// The Claude session, fixed at the first Run (D6).
  sessionId               String?          @db.Uuid
  branch                  String?
  /// Display only: the runner owns the path.
  worktree                String?
  issueNumber             Int?
  issueUrl                String?
  specPath                String?
  /// #379: a spec written to an external docs repository — its `owner/name`
  /// and pull request. Null when the spec is on the card's branch.
  specRepo                String?
  specPrNumber            Int?
  specPrUrl               String?
  prNumber                Int?
  prUrl                   String?
  /// #329 D6: from the PR poll, else the last `card.collect` / `card.merge`;
  /// `null` while the card has no PR or its state is not known yet.
  prState                 CardPrState?
  /// #329 D2: written on every collect attempt, for every source.
  collectState            CardCollectState @default(none)
  /// #329 D2: the runner's one-line message of a failed collect, at most 500
  /// characters; cleared by a collect that does not fail.
  collectError            String?
  /// #329 D4: automatic attempts since the last manual collect (at most 3).
  collectAttempts         Int              @default(0)
  /// When the last collect attempt ended.
  collectedAt             DateTime?
  /// #359 D5: the checks on `ciHeadSha`, from the last `card.checks`.
  ciState                 CardCiState      @default(none)
  /// #359 D5: the failed checks, `[{name, link}]` (shared `cardCiCheckSchema`);
  /// `null` unless `ciState` is `red`.
  ciChecks                Json?
  /// #359 D5, D6: the PR head `ciState` describes; a red head is acted on once.
  ciHeadSha               String?
  /// #359 D5: when `card.checks` last answered.
  ciCheckedAt             DateTime?
  /// #359 D6: `ci_fix` rounds on the current PR (at most 3).
  ciFixAttempts           Int              @default(0)
  /// #484: since when `ciHeadSha` has had no checks (`ciState` `none`);
  /// `null` while it has some. Reset when the head is retriggered.
  ciNoneSince             DateTime?
  /// #484: the head `card.ciRetrigger` was sent for — once per head.
  ciRetriggeredSha        String?
  /// #359 D6: CI still failing after the budget — no automation until a person acts.
  needsPerson             Boolean          @default(false)
  /// #542: why `needsPerson` is set (shared `CARD_NEEDS_PERSON_REASONS`);
  /// `null` while it is not, and for a card marked before #542.
  needsPersonReason       String?
  /// #359 D8: when the latest PR merged; the card stays in Finished as Merged.
  mergedAt                DateTime?
  /// Nullable so deleting a user keeps the card.
  createdById             String?
  movedById               String?
  completedById           String?
  movedAt                 DateTime
  completedAt             DateTime?
  /// #244: the extraction that suggested the card.
  captureId               String?
  /// #244: the manual session it was captured from; kept after Accept.
  sourceSessionId         String?
  /// #244: why it was suggested, at most 300 characters.
  captureWhy              String?
  /// #244: 0–1.
  captureConfidence       Float?
  /// #244 D8: `[{contentId, kind, excerpt}]`, excerpts of at most 300
  /// characters; content-derived, so operators only. Accept clears it.
  evidence                Json?
  /// #244 D6: sha256 of the normalized title (shared `captureFingerprint`);
  /// written on every card, so a suggestion matching it is dropped.
  fingerprint             String?
  /// #273 D9: why approving the design did not start the worker — a
  /// `BoardErrorCode` or `unknown`. Cleared when a round starts or the design reopens.
  autoRunError            String?
  /// At most 500 characters.
  autoRunMessage          String?
  autoRunFailedAt         DateTime?
  /// #443: the accepted dependency whose acceptance tried the failed auto-run;
  /// `null` when the failure came from approving the design (#273).
  autoRunAfter            Int?
  /// #443: Auto-run when ready — accepting the last open dependency starts
  /// the Run. Off by default; it turns itself off when it fires, so it starts
  /// the card at most once.
  autoRunWhenReady        Boolean          @default(false)
  /// #282 D1: the manual session a `terminal` card tracks; unique, so a
  /// second `card.track` of the session updates its card.
  trackedSessionId        String?          @unique
  /// #282 D3: Automatic work — collect when the tracked session finishes.
  /// Starts from `board_settings.autoCollectTracked`.
  autoCollect             Boolean          @default(false)
  /// #282 D4: a `fleet` card's key is `(projectId, fleetIssue, fleetSlot)`;
  /// `fleetSlot` is null for a `cs:ready` issue no slot has picked up. Postgres
  /// treats nulls as distinct, so that row is kept unique by the partial index
  /// `board_cards_fleet_unslotted_key` in the migration.
  fleetIssue              Int?
  fleetSlot               String?
  /// Shared `FLEET_STAGES`, written by the fleet projector.
  fleetStage              String?
  /// The slot left the projection; the card keeps its last column.
  fleetSlotGone           Boolean          @default(false)
  /// #337 D6, D7: the plan the card came from — a New Card intake or a New
  /// Plan's Create cards; kept as its origin.
  planId                  String?
  /// #480 (ADR-0044): the stage of the stack the card belongs to; at most one.
  stageId                 String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan               Plan?                  @relation(fields: [planId], references: [id], onDelete: SetNull)
  stage              BoardStackStage?       @relation(fields: [stageId], references: [id], onDelete: SetNull)
  trackedSession     AgentSession?          @relation("BoardCardTrackedSession", fields: [trackedSessionId], references: [id], onDelete: SetNull)
  createdBy          User?                  @relation("BoardCardCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  movedBy            User?                  @relation("BoardCardMovedBy", fields: [movedById], references: [id], onDelete: SetNull)
  completedBy        User?                  @relation("BoardCardCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  capture            CardCapture?           @relation(fields: [captureId], references: [id], onDelete: SetNull)
  sourceSession      AgentSession?          @relation("BoardCardSourceSession", fields: [sourceSessionId], references: [id], onDelete: SetNull)
  rounds             BoardCardRound[]
  design             TaskDesign?
  designTurns        PlanTurn[]
  textNormalizations TextNormalization[]
  attachments        Attachment[]
  assistantAttachments AssistantAttachment[]
  /// #337 D7: the plan task Create cards made this card from.
  planTasks          PlanTask[]             @relation("PlanTaskCard")
  /// #337 D8: the cards this one runs after.
  dependsOn          BoardCardDependency[]  @relation("BoardCardDependsOn")
  /// #337 D8: the cards that run after this one.
  dependants         BoardCardDependency[]  @relation("BoardCardDependant")
  /// #359 D8: every PR the card opened; `prUrl` is the latest.
  pullRequests       BoardCardPullRequest[]
  /// #592: the intake candidate accepted as this card.
  candidate          PlanCandidate?

  @@unique([projectId, number])
  @@unique([projectId, fleetIssue, fleetSlot])
  @@index([projectId, column, position])
  @@index([sessionId])
  @@index([projectId, fingerprint])
  @@index([planId])
  @@index([stageId])
  @@map("board_cards")
}

/// #337 D8: `cardId` runs after `dependsOnId`. Both cards are of one project
/// and the graph has no cycle — the API checks both on insert (shared
/// `findDependencyCycle`). Run warns on an open dependency; nothing blocks.
model BoardCardDependency {
  cardId      String
  dependsOnId String
  createdAt   DateTime @default(now())

  card      BoardCard @relation("BoardCardDependsOn", fields: [cardId], references: [id], onDelete: Cascade)
  dependsOn BoardCard @relation("BoardCardDependant", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([cardId, dependsOnId])
  @@index([dependsOnId])
  @@map("board_card_dependencies")
}

/// #480 (ADR-0044): a group of cards that make one larger piece of work,
/// ordered in stages, under one optional shared design. Every card of stage
/// N+1 has an ordinary `BoardCardDependency` on every card of stage N.
model BoardStack {
  id              String   @id @default(cuid())
  projectId       String
  /// Per project, `S-<number>`: max + 1 under `pg_advisory_xact_lock`.
  number          Int
  /// English, at most 200 characters.
  title           String
  /// Markdown, at most 20 000 characters.
  body            String   @default("")
  /// The intake that proposed it; kept as its origin.
  planId          String?
  /// The stack design turns' Claude session — `--session-id` first, then `--resume`.
  designSessionId String?  @db.Uuid
  /// Nullable so deleting a user keeps the stack.
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan        Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("BoardStackCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  stages      BoardStackStage[]
  design      TaskDesign?
  designTurns PlanTurn[]

  @@unique([projectId, number])
  @@map("board_stacks")
}

/// #480: one stage of a stack. Its cards may run in parallel; they wait on
/// every card of the stage before it.
model BoardStackStage {
  id       String @id @default(cuid())
  stackId  String
  /// 0-based, dense.
  position Int
  /// English, at most 80 characters; may be empty.
  title    String @default("")

  stack BoardStack  @relation(fields: [stackId], references: [id], onDelete: Cascade)
  cards BoardCard[]

  @@unique([stackId, position])
  @@map("board_stack_stages")
}

/// #359 D8: one PR of a card. A follow-up after a merge opens a new branch
/// and a new PR; every one is kept.
model BoardCardPullRequest {
  id        String      @id @default(cuid())
  cardId    String
  number    Int
  url       String
  /// The PR's head branch.
  branch    String
  state     CardPrState
  /// The round that opened it.
  round     Int
  createdAt DateTime    @default(now())

  card BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, number])
  @@map("board_card_pull_requests")
}

/// One Run or feedback of a card (D4), with its `runs` row of kind `card`.
model BoardCardRound {
  id                  String           @id @default(cuid())
  cardId              String
  round               Int
  runId               String           @unique
  trigger             CardRoundTrigger
  /// #443: started by Auto-run when ready, after this dependency (`C-<n>`)
  /// was accepted; `null` for a round a person or AgentDock started.
  autoRunAfter        Int?
  /// The person's feedback (D9), at most 8 000 characters.
  feedback            String?
  /// #273 D1: the card text this round's prompt was built from.
  cardTitle           String
  cardBody            String
  cardKind            BoardCardKind
  /// #309 D10: the card's attachments this round's prompt was built from,
  /// `[{id, name, mime}]` (shared `cardAttachmentSnapshotSchema`).
  cardAttachments     Json             @default("[]")
  /// Nullable so deleting the author keeps the round.
  authorId            String?
  phase               CardRoundPhase   @default(queued)
  /// `agentdock-card-<shortId>`.
  tmuxSession         String?
  /// #367 D3: how the round's session reports (`plugin` | `injected` | `none`),
  /// from `card_run.started`; `null` until that event arrives.
  wiring              String?
  /// #367 D3: with `wiring = none`, why (shared `cardRunWiringReasonSchema`).
  wiringReason        String?
  finishedBy          CardFinishedBy?
  /// From `finish_card` (D6), at most 4 000 characters.
  summary             String?
  exitCode            Int?
  error               String?
  startedAt           DateTime         @default(now())
  waitingAt           DateTime?
  /// #390: when the round entered `background`; cleared when it leaves.
  backgroundAt        DateTime?
  /// #390: background tasks running at that stop.
  backgroundTasks     Int?
  /// #390: the newest running command, redacted and shortened; only for a
  /// project that ships content (ADR-0021).
  backgroundCommand   String?
  /// #390: when this stall raised `card.background_stalled` — once per stall.
  backgroundStalledAt DateTime?
  /// #489 M4: the question selector the round's session shows now — shared
  /// `pendingQuestionSchema` — from `card_run.pending_question`; only for a
  /// project that ships content (ADR-0021). Cleared once it is gone.
  pendingQuestion     Json?
  /// #482: the local error the API answered the round's last refused
  /// `finish_card` with (shared `localErrorCodeSchema`), from
  /// `card_run.finish_refused`; the round needs attention while it is active.
  finishRefusedCode   String?
  finishRefusedAt     DateTime?
  finishedAt          DateTime?
  endedAt             DateTime?
  /// #542: the card PR's head when the round started (`ciHeadSha`); `null`
  /// when the card had no PR then. Auto-merge refuses a head the round left
  /// as it found it.
  startHeadSha        String?
  /// #449 D3: how the round's session started, from `round.restart`; `null`
  /// until that event arrives, and for a runner older than Context handoff.
  restartMode         CardRestartMode?
  /// #449 D3: `{ resumeTokens, freshTokens, cacheWarm }` (shared
  /// `restartEstimateSchema`); `null` for a `first` round.
  restartEstimate     Json?
  /// #449 D3: the Claude session the round ran in, from `round.restart`. A
  /// `fresh` round starts a new one; the earlier rounds keep theirs, so an old
  /// session can still be resumed.
  sessionId           String?          @db.Uuid
  /// #449 D9: tokens and ms from the round's start to its first file edit,
  /// from `round.warmup`.
  warmupTokens        Int?
  warmupMs            Int?

  card   BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  run    Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  author User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  textNormalizations TextNormalization[]
  attachments        Attachment[]

  @@unique([cardId, round])
  @@index([phase])
  @@map("board_card_rounds")
}

/// #309 (ADR-0031): a file or screenshot on a board card or one round's
/// feedback. The bytes live in `ATTACHMENTS_DIR` as `<projectId>/<id>`, behind
/// the `AttachmentStore` port; a cascade deletes rows, never files — the
/// service removes them after the delete commits, and the sweep catches the rest.
model Attachment {
  id         String    @id @default(cuid())
  projectId  String
  /// Null while pending (D3): bound to the project and the uploader until a
  /// card claims it.
  cardId     String?
  /// Set for an attachment that came with a round's feedback.
  roundId    String?
  /// #337 D6, D10: claimed by a card intake while it runs (`expiresAt`
  /// cleared); the generated card claims it from the plan.
  planId     String?
  /// Nullable so deleting the uploader keeps the attachment.
  uploaderId String?
  /// The display name (D6), at most 200 characters.
  name       String
  /// Detected from the content (D5), one of the shared `ATTACHMENT_MIMES`.
  mime       String
  /// Bytes, at most 25 MiB.
  size       Int
  /// Lower-case hex SHA-256 of the bytes.
  sha256     String
  /// Set while pending (upload + 24 h), cleared on claim; the sweep deletes
  /// pending rows past it.
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  card     BoardCard?      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  round    BoardCardRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)
  plan     Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  uploader User?           @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  assistant AssistantAttachment?

  @@index([cardId, createdAt])
  @@index([planId])
  @@index([projectId])
  @@index([expiresAt])
  @@map("attachments")
}

/// A project's board settings (D2, D13). No row: the defaults.
model BoardSettings {
  projectId              String   @id
  issueOnRun             Boolean  @default(false)
  specOnRun              Boolean  @default(false)
  /// 1–10, checked by the DTO.
  maxRunning             Int      @default(3)
  /// #244 D10: on only while the project's `shipSessionContent` is on;
  /// turning content off turns it off.
  captureEnabled         Boolean  @default(false)
  /// Shared `CAPTURE_MODELS`: `haiku` or `sonnet`, checked by the DTO.
  captureModel           String   @default("haiku")
  /// #282 D3: the `autoCollect` a new `terminal` card starts with.
  autoCollectTracked     Boolean  @default(false)
  /// #359 D7: merge a card's PR on entering Finished. `null` is the default:
  /// on for a base other than the default branch (shared `cardAutoMergeDefault`).
  autoMergeCards         Boolean?
  /// #390: minutes in `background` before `card.background_stalled`; 5–1440,
  /// checked by the DTO.
  backgroundStallMinutes Int      @default(30)
  updatedById            String?
  updatedAt              DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("board_settings")
}

// ─── Card capture (issue #244, ADR-0026) ────────────────────────────────────

/// Shared `CAPTURE_STATUSES`.
enum CardCaptureStatus {
  queued
  running
  succeeded
  failed
  skipped
}

/// Shared `CAPTURE_SKIP_REASONS`.
enum CardCaptureSkipReason {
  too_little
  rate_limited
  inbox_full
  budget_exceeded
  runner_offline
  capture_off
  no_profile
  /// The session tracks a card (#282 D5).
  tracked
}

/// One extraction of a manual session's new content (D3, D4). The newest
/// row's `contentToId` is the session's watermark: content is never sent
/// twice. A content purge deletes the project's rows.
model CardCapture {
  id               String                 @id @default(cuid())
  projectId        String
  /// The manual session it reads.
  sessionId        String
  /// The `card_capture` run; null for an extraction skipped before it ran.
  runId            String?                @unique
  /// The extraction's own Claude session (`cards.extract` `sessionId`,
  /// `--session-id`): how the run is priced (ADR-0009).
  extractSessionId String?                @db.Uuid
  /// `session_contents.id` range read; `contentToId` is the next watermark.
  contentFromId    BigInt
  contentToId      BigInt
  inputChars       Int
  status           CardCaptureStatus      @default(queued)
  skipReason       CardCaptureSkipReason?
  /// Never content; `contract_violation: …` for an output that broke D5.
  error            String?
  /// The model's result, at most 32 KiB; deleted with content retention.
  resultText       String?
  /// Cards it put in the Inbox.
  suggested        Int                    @default(0)
  createdAt        DateTime               @default(now())
  finishedAt       DateTime?

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run     Run?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  cards   BoardCard[]

  @@index([projectId, createdAt])
  @@index([sessionId, createdAt])
  @@map("card_captures")
}

/// A dismissed suggestion's fingerprint (D9): blocks it for 90 days; a daily
/// job deletes older rows.
model CardDismissal {
  id            String   @id @default(cuid())
  projectId     String
  /// sha256 of the normalized title (shared `captureFingerprint`).
  fingerprint   String
  /// At most 120 characters: the suggestion's title, for the record.
  title         String
  /// Nullable so deleting the user keeps the row.
  dismissedById String?
  createdAt     DateTime @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dismissedBy User?   @relation(fields: [dismissedById], references: [id], onDelete: SetNull)

  @@index([projectId, fingerprint])
  @@index([createdAt])
  @@map("card_dismissals")
}

// ─── Text normalization (issue #271, ADR-0027) ──────────────────────────────

/// Shared `TEXT_OWNER_TYPES` (D1).
enum TextOwnerType {
  board_card
  board_card_round
  design_comment
  plan
  plan_task
  plan_turn
  /// #584: a rule created from a scanned candidate.
  project_rule
}

/// Shared `TEXT_NORMALIZATION_STATUSES`.
enum TextNormalizationStatus {
  pending
  running
  done
  skipped
  failed
  superseded
}

/// Shared `TEXT_FAIL_REASONS` (D11), for `failed` and `skipped`.
enum TextFailReason {
  runner_offline
  runner_unsupported
  no_profile
  run_failed
  contract_violation
  budget_exceeded
  off
}

/// #324 D8: what translated a request — DeepL in the API, or `text.normalize`
/// on the runner (ADR-0033).
enum TextEngine {
  deepl
  runner
}

/// One save's request to normalize an owner's changed fields (D4, D7). The
/// owner's column holds the English text once applied; `fields` keeps the
/// original. Exactly one owner key is set (CHECK
/// `text_normalizations_owner_check`, the ADR-0025 precedent).
model TextNormalization {
  id            String                  @id @default(cuid())
  projectId     String
  ownerType     TextOwnerType
  cardId        String?
  roundId       String?
  commentId     String?
  planId        String?
  taskId        String?
  turnId        String?
  ruleId        String?
  /// `[{field, original, sourceHash, english?, outcome?}]` (shared `textFieldsSchema`).
  fields        Json
  /// D9: the request also asks for the card's kind.
  classifyKind  Boolean                 @default(false)
  /// The classified kind, when asked and answered.
  kind          BoardCardKind?
  status        TextNormalizationStatus @default(pending)
  failReason    TextFailReason?
  /// At most 2000 characters; never the text.
  error         String?
  attempts      Int                     @default(0)
  nextAttemptAt DateTime?
  /// The `text_normalize` run; null until sent, or for a request with no call.
  runId         String?                 @unique
  /// The Claude session the API assigns (`--session-id`): how the run is priced (ADR-0009).
  sessionId     String?                 @db.Uuid
  /// #324 D8: null until DeepL answered or a run was sent.
  engine        TextEngine?
  /// #324 D8: DeepL's `billed_characters`, else the characters sent to the runner.
  billedChars   Int?
  /// Nullable so deleting the author keeps the record.
  authorId      String?
  createdAt     DateTime                @default(now())
  finishedAt    DateTime?

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  card    BoardCard?      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  round   BoardCardRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)
  comment DesignComment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  plan    Plan?           @relation(fields: [planId], references: [id], onDelete: Cascade)
  task    PlanTask?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  turn    PlanTurn?       @relation(fields: [turnId], references: [id], onDelete: Cascade)
  rule    ProjectRule?    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  run     Run?            @relation(fields: [runId], references: [id], onDelete: SetNull)
  author  User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
  @@index([roundId, createdAt])
  @@index([commentId, createdAt])
  @@index([planId, createdAt])
  @@index([taskId, createdAt])
  @@index([turnId, createdAt])
  @@index([ruleId, createdAt])
  @@index([projectId, status])
  @@map("text_normalizations")
}

/// A project's text settings (D13). No row: on.
model TextSettings {
  projectId        String   @id
  normalizeEnabled Boolean  @default(true)
  updatedById      String?
  updatedAt        DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("text_settings")
}

/// Token saver (#445, ADR-0039).

/// The launch a filtered command ran under (shared `TOKEN_SAVER_RUN_KINDS`).
/// `orchestrator` is the project's orchestrator session and `manual` a session
/// the runner did not launch (`/cs-eco`, #475); neither has a run.
enum TokenSaverRunKind {
  card
  skill
  plan
  card_assess
  card_capture
  ui_profile
  text_normalize
  orchestrator
  manual
}

/// A project's Token saver setting (D11). No row: on, with an empty allowlist.
model TokenSaverSettings {
  projectId   String   @id
  enabled     Boolean  @default(true)
  /// D6: MCP servers a launch may load besides `agentdock`, by name.
  mcpAllow    String[] @default([])
  updatedById String?
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("token_saver_settings")
}

/// One filtered command (D12), from the runner's `filter.stats` event.
/// `id` is the runner's, so a resent `events` batch inserts nothing twice.
model TokenSaverStat {
  id            String            @id
  projectId     String
  /// Null for the orchestrator and manual sessions, or a run the API does not know.
  runId         String?
  runKind       TokenSaverRunKind
  /// `<family>/<command>`, e.g. `js/jest`; `none` when no filter matched.
  filter        String
  rawBytes      Int
  keptBytes     Int
  /// `AGENTDOCK_RAW=1`: the command ran unfiltered.
  bypassed      Boolean
  /// The filter returned the original output.
  passedThrough Boolean
  createdAt     DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run     Run?    @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([runId])
  @@map("token_saver_stats")
}

// Steward (issue #447, ADR-0040)

/// Mirrors `STEWARD_SUBJECT_KINDS`. `fleet_slot` is observe-only (D5).
enum StewardSubjectKind {
  card_round
  run
  fleet_slot
}

/// Mirrors `STEWARD_INCIDENT_KINDS`.
enum StewardIncidentKind {
  api_error
  dialog
  permission_prompt
  quota
  silent
  dead_session
  trailer
  unknown
}

/// Mirrors `STEWARD_INCIDENT_STATUSES`. `escalated` is still open (D13).
enum StewardIncidentStatus {
  open
  resolved
  escalated
}

/// A project's Steward setting (D16). A missing row means `STEWARD_DEFAULTS`.
model StewardSettings {
  projectId      String   @id
  enabled        Boolean  @default(true)
  /// D6: minutes without a hook event or a live background task.
  silenceMinutes Int      @default(10)
  /// D14: `HH:MM` in the person's timezone.
  digestTime     String   @default("09:00")
  autoNudge      Boolean  @default(true)
  autoDismiss    Boolean  @default(true)
  autoResume     Boolean  @default(true)
  trailerGuard   Boolean  @default(true)
  updatedById    String?
  updatedAt      DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("steward_settings")
}

/// One stall of one subject, from open to resolved (D13). `subjectId` is the
/// `board_card_rounds.id`, the `runs.id`, or the slot name — no foreign key,
/// so a fleet slot fits and history outlives its subject.
model StewardIncident {
  id             String                @id @default(cuid())
  projectId      String
  subjectKind    StewardSubjectKind
  subjectId      String
  kind           StewardIncidentKind
  /// One line (D12): the rule's, or haiku's for `unknown`.
  reason         String
  /// `StewardActionRecord[]`: `{ action, at, result, detail? }`.
  actions        Json                  @default("[]")
  status         StewardIncidentStatus @default(open)
  openedAt       DateTime              @default(now())
  resolvedAt     DateTime?
  /// D13: the reason last notified; a different reason notifies again.
  notifiedReason String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, openedAt])
  @@index([subjectKind, subjectId, status])
  @@map("steward_incidents")
}

/// Mirrors `STEWARD_DIGEST_TRIGGERS` (D14).
enum StewardDigestTrigger {
  daily
  away_off
}

/// One delivered digest (D14) — `GET …/steward/digest/latest` reads the newest.
/// Stored because haiku's prose cannot be recomputed.
model StewardDigest {
  id        String               @id @default(cuid())
  projectId String
  trigger   StewardDigestTrigger
  /// The period covered.
  from      DateTime
  to        DateTime
  /// `{ done, stuck, waiting, spendUsd }` of `StewardDigestView`.
  content   Json
  /// haiku's summary; null when the template was used (runner offline).
  prose     String?
  createdAt DateTime             @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("steward_digests")
}

/// Mirrors `CARD_RESTART_MODES` (#449 D3).
enum CardRestartMode {
  resume
  fresh
  first
}

/// Mirrors `HANDOFF_SUBJECT_KINDS` (#449 D1).
enum HandoffSubjectKind {
  card
  run
}

/// Mirrors `HANDOFF_UPDATED_BY` (#449 D2, D7).
enum HandoffUpdatedBy {
  agent
  haiku
  person
}

/// #449 (ADR-0042): the API's copy of a card's or a run's handoff note. The
/// runner keeps the note on the machine always (D4); a row exists only for a
/// project with session content on (ADR-0021).
model HandoffNote {
  id          String             @id @default(cuid())
  projectId   String
  subjectKind HandoffSubjectKind
  /// `board_cards.id` or `runs.id`.
  subjectId   String
  /// The note's markdown (shared `validateHandoffNote`).
  content     String
  /// `HandoffLineRange[]`: the lines a person wrote (D7), `[{ from, to }]`.
  personLines Json               @default("[]")
  updatedBy   HandoffUpdatedBy
  updatedAt   DateTime           @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([subjectKind, subjectId])
  @@index([projectId])
  @@map("handoff_notes")
}

/// Mirrors `PROJECT_RULE_SOURCES` of the shared contract (#528).
enum ProjectRuleSource {
  manual
  imported
  scanned
}

/// A per-project coding rule a card worker follows (#528, stack S-2). Stored
/// here, never in a file of the project's repository. `position` orders the
/// list, 0-based and dense; a reorder rewrites it.
model ProjectRule {
  id          String            @id @default(cuid())
  projectId   String
  /// At most `PROJECT_RULE_TITLE_MAX` characters, checked by the DTO.
  title       String
  /// At most `PROJECT_RULE_DESCRIPTION_MAX` characters, checked by the DTO.
  description String            @default("")
  enabled     Boolean           @default(true)
  position    Int
  source      ProjectRuleSource @default(manual)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  textNormalizations TextNormalization[]

  @@index([projectId, position])
  @@map("project_rules")
}

// ─── LLM gateway (ADR-0059, #598) ───────────────────────────────────────────

/// Mirrors `LLM_PROVIDERS` of the shared contract.
enum LlmProvider {
  anthropic
  openai
  xai
  openrouter
}

/// Mirrors `LLM_FEATURES` of the shared contract: what a call was for.
enum LlmFeature {
  assistant
  digest
  summary
  search
  triage
  title
}

enum LlmCallOutcome {
  ok
  error
  aborted
}

/// One provider's key, monthly cap and enabled models. The migration writes a
/// row per provider; the key is never stored in the clear (ADR-0059 §3).
model LlmProviderSetting {
  provider      LlmProvider @id
  /// The key sealed with `LLM_SECRETS_KEY` (`SecretCipher`'s v1 format).
  keyCiphertext String?
  /// The key's last four characters — the only part the API returns.
  keySuffix     String?
  keyUpdatedAt  DateTime?
  /// USD per UTC calendar month; 0 disables the provider.
  capUsd        Decimal     @db.Decimal(12, 2)
  /// Model ids offered for this provider; each priced by the price table.
  models        String[]    @default([])
  updatedAt     DateTime    @updatedAt
  updatedById   String?

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("llm_provider_settings")
}

/// The usage ledger: one row per gateway call, priced from the price table
/// (ADR-0009) when it ends. A provider's month spend is the sum of `costUsd`.
model LlmCall {
  id           String         @id @default(cuid())
  ts           DateTime       @default(now()) @db.Timestamptz(3)
  /// Who the call was made for; null for the system or a deleted user.
  userId       String?
  provider     LlmProvider
  model        String
  feature      LlmFeature
  outcome      LlmCallOutcome
  /// An `LlmErrorCode` when `outcome` is not `ok`.
  errorCode    String?
  input        Int            @default(0)
  output       Int            @default(0)
  cacheRead    Int            @default(0)
  cacheWrite5m Int            @default(0)
  cacheWrite1h Int            @default(0)
  /// Counted inside `output`, as in `llm_requests`.
  reasoning    Int            @default(0)
  costUsd      Decimal        @db.Decimal(14, 6)
  /// `price_versions.number` the cost was computed with.
  priceVersion Int
  durationMs   Int

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, ts])
  @@index([ts])
  @@map("llm_calls")
}

// ─── Assistant (ADR-0060, #608) ─────────────────────────────────────────────

/// Mirrors `ASSISTANT_MESSAGE_ROLES` of the shared contract.
enum AssistantMessageRole {
  user
  assistant
}

/// Mirrors `ASSISTANT_ATTACHMENT_KINDS` of the shared contract.
enum AssistantAttachmentKind {
  card
  session
  file
}

/// One person's chat with the assistant. Personal: only `userId` reads it.
model AssistantConversation {
  id        String       @id @default(cuid())
  userId    String
  /// Null is Auto: the assistant works the project out from the message and
  /// records it here once resolved.
  projectId String?
  /// Null until the first reply; written by the cheapest enabled model.
  title     String?
  /// The model picked for the conversation; null is the instance default.
  provider  LlmProvider?
  model     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages    AssistantMessage[]
  attachments AssistantAttachment[]

  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String               @id @default(cuid())
  conversationId String
  role           AssistantMessageRole
  /// English, canonical: what later turns send the model and what search reads.
  content        String
  /// The text in the person's language, as shown.
  displayContent String
  /// BCP 47 primary language of `displayContent`, e.g. `en`, `ru`.
  language       String
  /// The model's tool calls of the turn: `[{id, name, input}]`.
  toolCalls      Json?
  /// Their results, by call id: `[{id, name, ok, summary}]`.
  toolResults    Json?
  provider       LlmProvider?
  model          String?
  /// The `llm_calls` rows of the turn (the title call excluded).
  llmCallIds     String[]             @default([])
  createdAt      DateTime             @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  AssistantAttachment[]

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

/// A card, a session or a file attached to a conversation. Pending while
/// `messageId` is null; the next message sent takes every pending one.
model AssistantAttachment {
  id             String                  @id @default(cuid())
  conversationId String
  messageId      String?
  kind           AssistantAttachmentKind
  /// `card`: the Board card.
  cardId         String?
  /// `session`: the agent session (its project ships content, ADR-0021).
  sessionId      String?
  /// `file`: the stored upload (ADR-0031), claimed for the assistant.
  attachmentId   String?                 @unique
  /// What the chip shows: `C-12 Title`, the session's title, the file name.
  label          String
  createdAt      DateTime                @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      AssistantMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  card         BoardCard?            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  session      AgentSession?         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachment   Attachment?           @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([messageId])
  @@map("assistant_attachments")
}
