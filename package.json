{
  "name": "nautelle",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "start:dev": "turbo run start:dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "turbo run db:migrate --filter=@nautelle/api",
    "db:generate": "turbo run db:generate --filter=@nautelle/api",
    "db:seed": "turbo run db:seed --filter=@nautelle/api",
    "db:studio": "cd apps/api && bunx prisma studio",
    "db:setup": "sh scripts/db-start-docker.sh",
    "admin:create": "bun run --cwd apps/api admin:create",
    "format": "biome format --write .",
    "check:secrets": "sh scripts/check-secrets.sh",
    "docs:env": "bun scripts/env-reference.ts",
    "docs:dev": "bun run --cwd apps/docs start:docs",
    "check": "biome check . && bun scripts/check-ci.ts && bun scripts/check-images.ts && bun scripts/check-brand.ts && bun scripts/check-pins.ts && bun scripts/check-numbering.ts && bun scripts/env-reference.ts --check && bun test ./scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "turbo": "2.9.5",
    "typescript": "6.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
