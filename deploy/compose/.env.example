# Nautelle install settings (docs/guides/install.md). install.sh writes .env
# from this file and fills every secret with random bytes; it never overwrites
# an existing .env. To set it up by hand: copy it to .env, fill the empty
# secrets (`openssl rand -hex 24` for a password, `openssl rand -base64 32` for
# a key), then `docker compose up -d`.

# The address people open, without a trailing slash. API_URL, WEB_URL,
# APP_URL and PUBLIC_URL derive from it; set one here to override it.
# `PUBLIC_URL=` (empty) keeps the GitHub App's webhook off: install.sh writes
# it for an http:// URL, which GitHub cannot reach.
NAUTELLE_URL=http://localhost:8000

# The exposure mode: local, tunnel or tls (exactly one).
COMPOSE_PROFILES=local

# local: where Caddy listens on the host. 0.0.0.0 opens it to the network.
NAUTELLE_BIND=127.0.0.1
NAUTELLE_PORT=8000

# tunnel: the token of a remote-managed Cloudflare tunnel whose public
# hostname points at http://proxy:80. NAUTELLE_URL is that hostname's https URL.
TUNNEL_TOKEN=

# tls: the domain Caddy gets a certificate for. Its DNS points at this host and
# ports 80 and 443 are open. NAUTELLE_URL is https://<domain>.
NAUTELLE_DOMAIN=

# Image tag: latest, or a release such as 0.15.0.
NAUTELLE_VERSION=latest

# `production` marks cookies Secure. install.sh writes `development` for an
# http:// NAUTELLE_URL, where a browser would drop them.
APP_ENV=production

# Database and Redis passwords. Required: there is no default.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# 32 random bytes, base64 each. Never change one once set, and keep them out
# of database backups: APP_ENCRYPTION_KEY seals stored secrets (Telegram,
# two-factor, GitHub App), AUDIT_HMAC_KEY keys the audit chain and
# LLM_SECRETS_KEY seals the AI provider keys.
APP_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=
LLM_SECRETS_KEY=
