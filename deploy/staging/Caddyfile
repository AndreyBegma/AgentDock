# The single public origin of staging (ADR-0016). TLS ends at Cloudflare;
# cloudflared connects here over plain HTTP inside the compose network.
{
	auto_https off
	admin off
	servers {
		# Keep cloudflared's X-Forwarded-For / -Proto: it is the only client and
		# sits on the private bridge. The API trusts this hop (TRUST_PROXY).
		trusted_proxies static private_ranges
	}
}

:80 {
	# Nothing above 10 MB reaches the API or web: Caddy answers 413 itself, so a
	# large body cannot exhaust the upstreams (C-134, F-32).
	request_body {
		max_size 10MB
	}

	# TLS ends at Cloudflare, so HSTS is set here for the browser.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}

	# Pairing and hook responses carry a token or a decision: never cached.
	# Matched on the original path, before handle_path strips /api.
	@uncached path /api/runners/pair /api/hooks/*
	header @uncached Cache-Control "no-store"

	# The API has no /api prefix of its own; the runner pairs with
	# https://<host>/api and dials wss://<host>/api/runner.
	#
	# A deploy replaces the containers (20-60 s with migrate and seed). Instead of
	# a 502 while the name does not resolve or the port is closed, a request or
	# WebSocket upgrade is held and retried until the upstream answers (#368).
	handle_path /api/* {
		reverse_proxy api:8180 {
			lb_try_duration 60s
			lb_try_interval 250ms
			health_uri /health
			health_interval 2s
		}
	}

	handle {
		reverse_proxy web:3517 {
			lb_try_duration 60s
			lb_try_interval 250ms
		}
	}
}
