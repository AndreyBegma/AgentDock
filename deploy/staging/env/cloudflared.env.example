# Token of the `agentdock-staging` Cloudflare tunnel — its own tunnel, not a
# connector on denitsa's. Zero Trust → Networks → Tunnels → agentdock-staging →
# the token from the install command. Public hostname, set in the dashboard:
#
#   staging-agentdock.luna-realm.com  →  HTTP  proxy:80
#
# The one value a person supplies by hand; keep a copy in
# ~/.agentdock/cloudflared-staging.env (mode 600).
TUNNEL_TOKEN=
