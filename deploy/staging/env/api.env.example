# API environment on staging — see apps/api/.env.example for every variable.
# refresh.sh copies this to env/api.env on the first run and generates
# APP_ENCRYPTION_KEY when it is empty. DATABASE_URL and REDIS_URL come from
# docker-compose.yml, built from the passwords in .env.
PORT=8180
# Secure cookies.
APP_ENV=production
# The origin the runner pairs with: Caddy strips /api before the API sees it.
API_URL=https://staging-agentdock.luna-realm.com/api
# CORS and the WebSocket Origin check.
WEB_URL=https://staging-agentdock.luna-realm.com
APP_URL=https://staging-agentdock.luna-realm.com
# GitHub App webhook base (POST <PUBLIC_URL>/hooks/github).
PUBLIC_URL=https://staging-agentdock.luna-realm.com/api
# cloudflared → Caddy → API: both hops are on the private compose bridge.
TRUST_PROXY=uniquelocal
# 32 random bytes, base64 — generated on the first run. Staging's own key.
APP_ENCRYPTION_KEY=
# Board card attachments (#309): the `attachments` volume of docker-compose.yml.
ATTACHMENTS_DIR=/data/attachments
# DeepL translates saved text at save time (#324). Empty: the runner path.
DEEPL_API_KEY=
