{
  "name": "@agentdock/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "require": "./dist/protocol/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "protocol": [
        "./dist/protocol/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome lint src",
    "test": "tsc -p tsconfig.test.json && bun test"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "^6.0.2"
  }
}
