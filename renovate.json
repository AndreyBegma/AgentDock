{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Security pull requests for every manager (C-173), @andrewbehma/glass-ui, pinned, and the docker image digests (F-31), all into develop (#171) and never automerged. Every other update is made by hand.",
  "baseBranchPatterns": ["develop"],
  "automerge": false,
  "pinDigests": true,
  "dependencyDashboard": false,
  "semanticCommits": "enabled",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "rangeStrategy": "pin",
    "semanticCommitType": "fix",
    "semanticCommitScope": "deps",
    "labels": ["security"],
    "automerge": false
  },
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@andrewbehma/glass-ui"],
      "enabled": true,
      "rangeStrategy": "pin",
      "semanticCommitType": "chore",
      "semanticCommitScope": "web",
      "labels": ["glass-ui"],
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "enabled": true,
      "pinDigests": true,
      "semanticCommitType": "chore",
      "semanticCommitScope": "deploy",
      "labels": ["docker"],
      "automerge": false
    }
  ]
}
