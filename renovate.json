{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "@andrewbehma/glass-ui, pinned, and the docker image digests (F-31), as pull requests into develop (#171). Every other dependency is updated by hand.",
  "baseBranchPatterns": ["develop"],
  "enabledManagers": ["bun", "dockerfile", "docker-compose"],
  "pinDigests": true,
  "dependencyDashboard": false,
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@andrewbehma/glass-ui"],
      "enabled": true,
      "rangeStrategy": "pin",
      "semanticCommitType": "chore",
      "semanticCommitScope": "web",
      "labels": ["glass-ui"],
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "enabled": true,
      "pinDigests": true,
      "semanticCommitType": "chore",
      "semanticCommitScope": "deploy",
      "labels": ["docker"],
      "automerge": false
    }
  ]
}
